      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "98c096b825d6299a078433008842cd0f15d8f488021ff91a33dd5c0311241cd4"
    },
    {
      "id": "dressing.story.6.intro.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.6.intro.audio.wav",
