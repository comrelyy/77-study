      "volume": 100,
      "sha256": "e16a9854cf0f6697cd226c00535854c486e4ec8f7616d3940484911ca09b4afa"
    },
    {
      "id": "dressing.story.4.more2.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.4.more2.audio.wav",
      "text": "Well done. You did it yourself!",
