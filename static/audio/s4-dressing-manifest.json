      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "bd76513f93b3e7ea30fd7ac3112cd58d3e7de847c172cb3d0813e72e1c953393"
    },
    {
