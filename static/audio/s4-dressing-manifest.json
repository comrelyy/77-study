      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "47b6dab1c1a7327f9d16b0e2b88f1e0b226e3f09f6a01fa1339b2a467b3c0c13"
    },
