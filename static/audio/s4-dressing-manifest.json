      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "adbbe92baae0ca0b5dc307d0abd539c731faaed4773a5ea92581b654a044e83d"
    },
    {
      "id": "dressing.story.6.more1.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.6.more1.audio.wav",
