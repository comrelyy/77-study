      "volume": 100,
      "sha256": "f26883899abcde115c38aa4aebd7f8b68b828cde3a4044360e1dbd753f52dcfd"
    },
    {
      "id": "dressing.story.6.reply.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.6.reply.audio.wav",
      "text": "Ready! Let us walk together.",
