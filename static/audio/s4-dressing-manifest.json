      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "cd953cb62fb9c4da9cc3ea9f843d4a5989db96b5931a56f42616feafac318cc2"
    },
    {
      "id": "dressing.story.5.intro.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.5.intro.audio.wav",
