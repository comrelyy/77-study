    },
    {
      "id": "dressing.story.3.reply.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.3.reply.audio.wav",
      "text": "Let us swap them. Try walking again.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "264554ee20635416b3c42e5322aa1cf682e0fa1b67b56b82af5ee66fba213622"
    },
    {
      "id": "dressing.story.3.more1.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.3.more1.audio.wav",
      "text": "Oh! Left and right were mixed up.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "796e6291e3331b35af4ff9b5f0f5f9cc090c131e608dbffaabaf9337f0f78d8d"
    },
    {
      "id": "dressing.story.3.more2.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.3.more2.audio.wav",
      "text": "Now they look right. Can you walk?",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "71db7ddcf7b6490ab4b2e84d7f54d92daae37b392c796d25434ddc2efc5de732"
    },
    {
      "id": "dressing.story.4.intro.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.4.intro.audio.wav",
      "text": "Lulu brings the hat.",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro am_michael",
      "rate": 1.0,
      "volume": 100,
      "sha256": "600ec708090c2ec9ca115352694d8262208d35fe66766c12fa478b18b8ae454a"
    },
    {
      "id": "dressing.story.4.item.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.4.item.audio.wav",
      "text": "Would you like some help?",
