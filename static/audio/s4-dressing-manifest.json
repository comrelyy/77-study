      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "91c7a3d522b2ac95292f32bbe852a6bda015f85bfed92e7128f7982f78446b44"
    },
    {
