      "volume": 100,
      "sha256": "2be9304adf0d1e6629134cd4aacf368fdf394230d2adfd7e540211a3cb341575"
    },
    {
      "id": "dressing.story.6.item.audio",
      "path": "audio/dressing/v0-2-0/dressing.story.6.item.audio.wav",
      "text": "Shirt, socks, shoes, hat. Ready?",
