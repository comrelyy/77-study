      "rate": -2,
      "volume": 90,
      "sha256": "ee48eca349cf8ab597b98c2ed60a0773693d2cf1f181c6a7b8040cc7208fa65a"
    },
    {
      "id": "picnic.story.1.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.1.reply.audio.wav",
      "text": "I can catch it. Here you are.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Microsoft Zira Desktop - English (United States)",
      "rate": -1,
      "volume": 90,
      "sha256": "7fe635ea81e76683e6f3d6202a4053f65f1e0060a596336546f041c173e07d02"
    },
    {
      "id": "picnic.story.2.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.2.intro.audio.wav",
      "text": "Lulu takes out a banana.",
      "language": "en-US",
