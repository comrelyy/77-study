    },
    {
      "id": "picnic.story.3.item.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.item.audio.wav",
      "text": "How can we both have some?",
      "language": "en-US",
      "role": "momo",
      "voice": "Microsoft Zira Desktop - English (United States)",
      "rate": -2,
      "volume": 90,
      "sha256": "4ef370b143e2bc1f7a8b6b879b8a3448ef9029a464a3b65e057b0f1c1e1f40e5"
    },
    {
      "id": "picnic.story.3.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.reply.audio.wav",
      "text": "We can share it. Half for each of us.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Microsoft Zira Desktop - English (United States)",
      "rate": -1,
      "volume": 90,
