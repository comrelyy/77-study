      "volume": 90,
      "sha256": "c2f34cc0cb00a74f047c878c6366a9070cfa91be5d3940d7ab48f67f74eb6dc9"
    },
    {
      "id": "picnic.story.2.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.2.reply.audio.wav",
      "text": "Yes, please. You can have the apple.",
      "language": "en-US",
      "role": "momo",
      "voice": "Microsoft Zira Desktop - English (United States)",
      "rate": -2,
      "volume": 90,
      "sha256": "59c8f48df58a1f8493bddaa9251148d53d754729ef2b470b4c69c79e734e8e19"
    },
    {
      "id": "picnic.story.3.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.intro.audio.wav",
      "text": "There is one big piece of bread.",
      "language": "en-US",
      "role": "narrator",
