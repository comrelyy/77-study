      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "516afff4f25fbb38e5b76c5719e8e64bef29f42407a5b0aaa6b4ddea11fa9678"
    },
    {
      "id": "picnic.story.1.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.1.intro.audio.wav",
      "text": "An apple rolls out of the picnic basket.",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro af_heart",
      "rate": 1.0,
      "volume": 100,
      "sha256": "2de57fb0897d631346af29f80fb4346883fdfcb85d62e68c9e82cff3ac0a37cc"
    },
    {
      "id": "picnic.story.1.item.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.1.item.audio.wav",
      "text": "Oh! Our apple!",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "d8a8366d80e16fe04526f184bfc3d7e0baf0eed26e0997aea6a2e1569e69095d"
    },
    {
      "id": "picnic.story.1.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.1.reply.audio.wav",
      "text": "I can catch it. Here you are.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "5a114021c84f341df3e4a59e74c1dafc76b71f3377910805aeb9430d75b1cb23"
    },
    {
      "id": "picnic.story.1.more1.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.1.more1.audio.wav",
      "text": "Thank you, Lulu. Good catch!",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "e28930e5f463ef5d7a132856703eac10cb66a25d73b5d65c6880b9d5cab797d1"
    },
    {
      "id": "picnic.story.2.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.2.intro.audio.wav",
      "text": "Lulu takes out a banana.",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro af_heart",
      "rate": 1.0,
      "volume": 100,
      "sha256": "4f173a44105384bb732ce3923b21132abdd77f02509371b5ec456fccfed98e89"
    },
    {
      "id": "picnic.story.2.item.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.2.item.audio.wav",
      "text": "Would you like this banana?",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "3c165c93e1d02366220460b598124ca38001be8e4b8ebf75290d855f2bf4626a"
    },
    {
      "id": "picnic.story.2.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.2.reply.audio.wav",
      "text": "Yes, please. You can have the apple.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "b02a938c740a8765a48a5703993a9c048d6f7fb578437b7660df298a8772a462"
    },
    {
      "id": "picnic.story.2.more1.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.2.more1.audio.wav",
      "text": "Thank you. I like apples.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "6e9717964f3c0bced7814b30f872425e0f5c00ee8949edc4fa3d02ffbb7d0331"
    },
    {
      "id": "picnic.story.2.more2.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.2.more2.audio.wav",
      "text": "And I like bananas!",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "6cc9f376da75be9e674ac34d9cddac19b7bf781c4861b226c500e72a2b59b4e1"
    },
    {
      "id": "picnic.story.3.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.intro.audio.wav",
      "text": "There is one big piece of bread.",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro af_heart",
      "rate": 1.0,
      "volume": 100,
      "sha256": "3c6064a5c1363f29592dee84613440c2f6436e178949f40454ab904546210b7f"
    },
    {
      "id": "picnic.story.3.item.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.item.audio.wav",
      "text": "How can we both have some?",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "0814397d127b844b10eb3ef9125efb97189b219ae146ad4aeaaa9a16d74ee83b"
    },
    {
      "id": "picnic.story.3.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.reply.audio.wav",
      "text": "We can share it. Half for each of us.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "2329a0982b1e28d05c0fbad03c9e4f88e954b572e9560d8c7d229ff4645df0ee"
    },
    {
      "id": "picnic.story.3.more1.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.more1.audio.wav",
      "text": "Good idea. One half for you.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "e5812d74f307baa6f2d2f44f9b91f240d2c8a63024297a83292c129abc9508ac"
    },
    {
      "id": "picnic.story.3.more2.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.3.more2.audio.wav",
      "text": "And one half for you. Thank you!",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "da2a6d98e744034956c0a9063ef0875b6254e500ac081e700eb26ff14d65c7db"
    },
    {
      "id": "picnic.story.4.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.4.intro.audio.wav",
      "text": "Lulu offers Momo some milk.",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro af_heart",
      "rate": 1.0,
      "volume": 100,
      "sha256": "5b230a9e8503af926586cb7d7f2e0d0583d9464f86d4cbe16d37dc60060149be"
    },
    {
      "id": "picnic.story.4.item.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.4.item.audio.wav",
      "text": "Some milk?",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "8ed423659468bce47d3b047d7adc04c07204c115ebb225b6a8a088a74bcdf641"
    },
    {
      "id": "picnic.story.4.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.4.reply.audio.wav",
      "text": "Not now, thank you. Maybe later.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "f7812c0e8017e48ef7bcdbcb88b22f0ea5120b527ded3a13893fc2a3f740e7e0"
    },
    {
      "id": "picnic.story.4.more1.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.4.more1.audio.wav",
      "text": "Okay. I will keep it for you.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "4b06bb82058c85e3eba305f76803ca5e65533f5b5fd591931ce70a53da238796"
    },
    {
      "id": "picnic.story.5.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.5.intro.audio.wav",
      "text": "Lulu has been helping with the basket.",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro af_heart",
      "rate": 1.0,
      "volume": 100,
      "sha256": "6c30631c450cfc64279947fc05f4e4bd579a16b75f205cacf5b87b9ea131bff9"
    },
    {
      "id": "picnic.story.5.item.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.5.item.audio.wav",
      "text": "Your apple is waiting. Sit beside me.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "5ffc8a9df5c399f6a665aa939ba5f3c6da5d3bcf4f80594cbe6234ec124cc268"
    },
    {
      "id": "picnic.story.5.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.5.reply.audio.wav",
      "text": "Thank you! Now we can eat together.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "c0e67a0a40eb38365382828e12175eec0d84bdf834d723252a22960960ed9a91"
    },
    {
      "id": "picnic.story.5.more1.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.5.more1.audio.wav",
      "text": "This is a happy picnic.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "5bb10ebb1a072c9183cb116109fd34efc0b3e3f13e2d7bb8e277cfda903fbe8d"
    },
    {
      "id": "picnic.story.6.intro.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.6.intro.audio.wav",
      "text": "The picnic is over.",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro af_heart",
      "rate": 1.0,
      "volume": 100,
      "sha256": "3d4b0a467cb6489a19a3b2c68035af44fbf3eeb48d2c8e56fcffd227f97524e5"
    },
    {
      "id": "picnic.story.6.item.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.6.item.audio.wav",
      "text": "I will pack the bread away.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "dcabde4f0bdf3263d56632a99c84ed9f96200722a5ba6ef6908c46f9905fbf8d"
    },
    {
      "id": "picnic.story.6.reply.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.6.reply.audio.wav",
      "text": "I will carry the basket. See you, picnic spot!",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "1e0f86cabbe76bab032aaa17e7f256ff1c18b7e9d3437abb5c23667e96f6aa03"
    },
    {
      "id": "picnic.story.6.more1.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.6.more1.audio.wav",
      "text": "Is there anything left on the grass?",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "fbda7ff6a94bd585d796b4d99e754ba37ae8be6e87bf44fbd8ce0ff2c1fb4046"
    },
    {
      "id": "picnic.story.6.more2.audio",
      "path": "audio/picnic/v0-4-0/picnic.story.6.more2.audio.wav",
      "text": "No. It is all clean.",
      "language": "en-US",
      "role": "bunny",
      "voice": "Kokoro af_nova",
      "rate": 1.05,
      "volume": 100,
      "sha256": "36b426830d168d1b81ae4c2766f7a713e8ebbb1badba1fed5b13946a4d198841"
    },
    {
      "id": "picnic.lesson.bridge.audio",
      "path": "audio/picnic/lesson/bridge-a912c667.wav",
      "text": "Let us sit under the tree and eat.",
      "language": "en-US",
      "role": "momo",
      "voice": "Kokoro af_bella",
      "rate": 1.0,
      "volume": 100,
      "sha256": "b8ce5398774d626547472e9e0bd27eb9593e01f7b0434ed445fcf156eb7b412e"
    },
    {
      "id": "picnic.lesson.title.audio",
      "path": "audio/picnic/lesson/title-50feb6c6.wav",
      "text": "A Picnic with Friends",
      "language": "en-US",
      "role": "narrator",
      "voice": "Kokoro af_heart",
      "rate": 1.0,
      "volume": 100,
      "sha256": "6e55ffee0d9635b21f2f8592f5998fc26af33a5fd4ff3b8fc0293fa8ee8ec74c"
    }
  ]
