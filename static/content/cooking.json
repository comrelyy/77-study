            "id": "cooking.dialogue.6.reply.1",
            "text": "Yes, please!",
            "cn": "想，谢谢！",
            "image": "cooking.bowl.image",
            "audio": "cooking.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.6.reply.1.follow",
                "text": "Here is a little for you.",
                "audio": "cooking.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "cooking.dialogue.6.reply.2",
            "text": "Not now, thank you.",
            "cn": "现在不想，谢谢。",
            "image": "cooking.bread.image",
            "audio": "cooking.dialogue.6.reply.2.audio",
