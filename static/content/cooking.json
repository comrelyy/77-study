  "modules": {
    "story": [
      {
        "id": "cooking.story.1",
        "title": "1. 想给朋友准备点心",
        "templateId": "daily-life",
        "illustration": "cooking.story.1.image",
        "characters": [
          "cooking.momo",
          "cooking.bunny"
        ],
        "mainWord": "en.bowl.container",
        "hotspots": [
          {
            "word": "en.bowl.container",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 和 Lulu 想给朋友准备一份可以分享的点心，先找一个碗。",
        "segments": [
          {
            "id": "cooking.story.1.intro",
            "text": "Momo and Lulu are making a snack.",
            "cn": "Momo 和 Lulu 在做点心。",
            "speaker": "narrator",
            "audio": "cooking.story.1.intro.audio"
          },
          {
            "id": "cooking.story.1.item",
            "text": "Can we make something to share?",
            "cn": "我们做点能分享的东西好吗？",
            "speaker": "momo",
            "audio": "cooking.story.1.item.audio"
          },
          {
            "id": "cooking.story.1.reply",
            "text": "Yes! Let us find a bowl.",
            "cn": "好呀！我们去找一个碗。",
            "speaker": "bunny",
            "audio": "cooking.story.1.reply.audio"
          },
          {
            "id": "cooking.story.1.more1",
            "text": "Here is a big bowl.",
            "cn": "这儿有一个大碗。",
            "speaker": "momo",
            "audio": "cooking.story.1.more1.audio"
          },
          {
            "id": "cooking.story.1.more2",
            "text": "Good. Now what shall we put in it?",
            "cn": "好。我们往里面放什么呢？",
            "speaker": "bunny",
            "audio": "cooking.story.1.more2.audio"
          }
        ]
      },
      {
        "id": "cooking.story.2",
        "title": "2. 番茄滚走了",
        "templateId": "daily-life",
        "illustration": "cooking.story.2.image",
        "characters": [
          "cooking.momo",
          "cooking.fox"
        ],
        "mainWord": "en.tomato.food",
        "hotspots": [
          {
            "word": "en.tomato.food",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "番茄在桌上滚走，Fifi 及时扶住，把它放进碗里。",
        "segments": [
          {
            "id": "cooking.story.2.intro",
            "text": "A tomato rolls across the table.",
            "cn": "一个番茄滚过桌子。",
            "speaker": "narrator",
            "audio": "cooking.story.2.intro.audio"
          },
          {
            "id": "cooking.story.2.item",
            "text": "Our tomato is rolling away!",
            "cn": "我们的番茄滚走啦！",
            "speaker": "momo",
            "audio": "cooking.story.2.item.audio"
          },
          {
            "id": "cooking.story.2.reply",
            "text": "I have it! Let us put it in the bowl.",
            "cn": "我接住了！我们把它放进碗里吧。",
            "speaker": "fox",
            "audio": "cooking.story.2.reply.audio"
          },
          {
            "id": "cooking.story.2.more1",
            "text": "Thank you, Fifi. That was quick!",
            "cn": "谢谢你，Fifi。你真快！",
            "speaker": "momo",
            "audio": "cooking.story.2.more1.audio"
          }
        ]
      },
      {
        "id": "cooking.story.3",
        "title": "3. 勺子去哪了",
        "templateId": "daily-life",
        "illustration": "cooking.story.3.image",
        "characters": [
          "cooking.bunny",
          "cooking.turtle"
        ],
        "mainWord": "en.spoon.utensil",
        "hotspots": [
          {
            "word": "en.spoon.utensil",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Lulu 找不到搅拌的勺子，Toto 仔细看看，发现它藏在布下面。",
        "segments": [
          {
            "id": "cooking.story.3.intro",
            "text": "The spoon is under a cloth.",
            "cn": "勺子在一块布下面。",
            "speaker": "narrator",
            "audio": "cooking.story.3.intro.audio"
          },
          {
            "id": "cooking.story.3.item",
            "text": "We need a spoon for mixing.",
            "cn": "我们需要一把勺子来搅拌。",
            "speaker": "bunny",
            "audio": "cooking.story.3.item.audio"
          },
          {
            "id": "cooking.story.3.reply",
            "text": "Lift the cloth. Here it is.",
            "cn": "掀开布看看。在这儿呢。",
            "speaker": "turtle",
            "audio": "cooking.story.3.reply.audio"
          },
          {
            "id": "cooking.story.3.more1",
            "text": "Thank you, Toto. Now we can mix.",
            "cn": "谢谢你，Toto。现在我们可以搅拌了。",
            "speaker": "bunny",
            "audio": "cooking.story.3.more1.audio"
          }
        ]
      },
      {
        "id": "cooking.story.4",
        "title": "4. 给每个人留一份",
        "templateId": "daily-life",
        "illustration": "cooking.story.4.image",
        "characters": [
          "cooking.momo",
          "cooking.fox"
        ],
        "mainWord": "en.bread.food",
        "hotspots": [
          {
            "word": "en.bread.food",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 给自己和 Fifi 分面包，Fifi 提醒还有 Lulu 和 Toto。",
        "segments": [
          {
            "id": "cooking.story.4.intro",
            "text": "There is bread on the plate.",
            "cn": "盘子里有面包。",
            "speaker": "narrator",
            "audio": "cooking.story.4.intro.audio"
          },
          {
            "id": "cooking.story.4.item",
            "text": "One piece for me and one for you.",
            "cn": "一块给我，一块给你。",
            "speaker": "momo",
            "audio": "cooking.story.4.item.audio"
          },
          {
            "id": "cooking.story.4.reply",
            "text": "And one for Lulu and Toto!",
            "cn": "还有一块给 Lulu，一块给 Toto！",
            "speaker": "fox",
            "audio": "cooking.story.4.reply.audio"
          },
          {
            "id": "cooking.story.4.more1",
            "text": "Oh yes. One for everyone!",
            "cn": "对哦。每人一块！",
            "speaker": "momo",
            "audio": "cooking.story.4.more1.audio"
          },
          {
            "id": "cooking.story.4.more2",
            "text": "Now nobody is left out.",
            "cn": "这样谁都不会落下。",
            "speaker": "fox",
            "audio": "cooking.story.4.more2.audio"
          }
        ]
      },
      {
        "id": "cooking.story.5",
        "title": "5. 慢一点也能拌好",
        "templateId": "daily-life",
        "illustration": "cooking.story.5.image",
        "characters": [
          "cooking.fox",
          "cooking.turtle"
        ],
        "mainWord": "en.spoon.utensil",
        "hotspots": [
          {
            "word": "en.spoon.utensil",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Fifi 搅得太快，点心差点洒出来。Toto 帮忙扶碗，Fifi 放慢速度。",
        "segments": [
          {
            "id": "cooking.story.5.intro",
            "text": "Fifi stirs too quickly.",
            "cn": "Fifi 搅得太快了。",
            "speaker": "narrator",
            "audio": "cooking.story.5.intro.audio"
          },
          {
            "id": "cooking.story.5.item",
            "text": "Oops! It almost fell out.",
            "cn": "哎呀！差点洒出来。",
            "speaker": "fox",
            "audio": "cooking.story.5.item.audio"
          },
          {
            "id": "cooking.story.5.reply",
            "text": "Try a slow circle. I will hold the bowl.",
            "cn": "慢慢地转圈搅。我来扶着碗。",
            "speaker": "turtle",
            "audio": "cooking.story.5.reply.audio"
          },
          {
            "id": "cooking.story.5.more1",
            "text": "Slow and round. Like this?",
            "cn": "慢慢地转圈。像这样吗？",
            "speaker": "fox",
            "audio": "cooking.story.5.more1.audio"
          },
          {
            "id": "cooking.story.5.more2",
            "text": "Yes. That looks just right.",
            "cn": "对。这样刚刚好。",
            "speaker": "turtle",
            "audio": "cooking.story.5.more2.audio"
          }
        ]
      },
      {
        "id": "cooking.story.6",
        "title": "6. 我们的点心做好了",
        "templateId": "daily-life",
        "illustration": "cooking.story.6.image",
        "characters": [
          "cooking.momo",
          "cooking.bunny"
        ],
        "mainWord": "en.bowl.container",
        "hotspots": [
          {
            "word": "en.bowl.container",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "大家各帮一点忙，点心准备好了。Momo 邀请朋友一起分享。",
        "segments": [
          {
            "id": "cooking.story.6.intro",
            "text": "The bowl is ready on the table.",
            "cn": "碗放在桌上，准备好了。",
            "speaker": "narrator",
            "audio": "cooking.story.6.intro.audio"
          },
          {
            "id": "cooking.story.6.item",
            "text": "We all helped. Would you like some?",
            "cn": "我们都帮了忙。你想吃一点吗？",
            "speaker": "momo",
            "audio": "cooking.story.6.item.audio"
          },
          {
            "id": "cooking.story.6.reply",
            "text": "Yes, please. Let us share!",
            "cn": "好的，谢谢。我们一起分享吧！",
            "speaker": "bunny",
            "audio": "cooking.story.6.reply.audio"
          },
          {
            "id": "cooking.story.6.more1",
            "text": "Here you are. I hope you like it.",
            "cn": "给你。希望你喜欢。",
            "speaker": "momo",
            "audio": "cooking.story.6.more1.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "cooking.dialogue.1",
        "cn": "给朋友们准备什么呢？",
        "question": [
          {
            "id": "cooking.dialogue.1.question",
            "text": "What shall we make for our friends?",
            "audio": "cooking.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "cooking.dialogue.1.reply.1",
            "text": "A snack to share!",
            "cn": "一份一起吃的点心！",
            "image": "cooking.bowl.image",
            "audio": "cooking.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.1.reply.1.follow",
                "text": "Let us find a bowl first.",
                "audio": "cooking.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "cooking.dialogue.1.reply.2",
            "text": "Please help me choose.",
            "cn": "请帮我选一选。",
            "image": "cooking.tomato.image",
            "audio": "cooking.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.1.reply.2.follow",
                "text": "We can look at the ingredients together.",
                "audio": "cooking.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "cooking.dialogue.2",
        "cn": "番茄可以放在哪里？",
        "question": [
          {
            "id": "cooking.dialogue.2.question",
            "text": "Where can we put the tomato?",
            "audio": "cooking.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "cooking.dialogue.2.reply.1",
            "text": "In the bowl.",
            "cn": "放在碗里。",
            "image": "cooking.bowl.image",
            "audio": "cooking.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.2.reply.1.follow",
                "text": "Yes. Put it in gently.",
                "audio": "cooking.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "cooking.dialogue.2.reply.2",
            "text": "Please hold it for me.",
            "cn": "请帮我拿一下。",
            "image": "cooking.bowl.image",
            "audio": "cooking.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.2.reply.2.follow",
                "text": "I will hold the bowl while you put it in.",
                "audio": "cooking.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "cooking.dialogue.3",
        "cn": "用什么搅拌呢？",
        "question": [
          {
            "id": "cooking.dialogue.3.question",
            "text": "What can we use for mixing?",
            "audio": "cooking.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "cooking.dialogue.3.reply.1",
            "text": "The spoon, please.",
            "cn": "请拿勺子。",
            "image": "cooking.spoon.image",
            "audio": "cooking.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.3.reply.1.follow",
                "text": "Here it is. Try a slow circle.",
                "audio": "cooking.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "cooking.dialogue.3.reply.2",
            "text": "Show me, please.",
            "cn": "请示范一下。",
            "image": "cooking.spoon.image",
            "audio": "cooking.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.3.reply.2.follow",
                "text": "I can stir slowly while you hold the bowl.",
                "audio": "cooking.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "cooking.dialogue.4",
        "cn": "我们分享面包好吗？",
        "question": [
          {
            "id": "cooking.dialogue.4.question",
            "text": "Shall we share the bread?",
            "audio": "cooking.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "cooking.dialogue.4.reply.1",
            "text": "One piece for each friend.",
            "cn": "每个朋友一块。",
            "image": "cooking.bread.image",
            "audio": "cooking.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.4.reply.1.follow",
                "text": "Let us make sure everyone has some.",
                "audio": "cooking.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "cooking.dialogue.4.reply.2",
            "text": "I will help you share.",
            "cn": "我来帮你分。",
            "image": "cooking.bread.image",
            "audio": "cooking.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.4.reply.2.follow",
                "text": "Thank you. We can do it together.",
                "audio": "cooking.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "cooking.dialogue.5",
        "cn": "点心差点洒了，怎么办呢？",
        "question": [
          {
            "id": "cooking.dialogue.5.question",
            "text": "The food almost spilled. What can we do?",
            "audio": "cooking.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "cooking.dialogue.5.reply.1",
            "text": "Mix more slowly.",
            "cn": "搅慢一点。",
            "image": "cooking.spoon.image",
            "audio": "cooking.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "cooking.dialogue.5.reply.1.follow",
                "text": "Yes. I can help hold the bowl.",
                "audio": "cooking.dialogue.5.reply.1.follow.audio"
              }
