  "modules": {
    "story": [
      {
        "id": "transport.story.1",
        "title": "1. 一起去等车",
        "templateId": "daily-life",
        "illustration": "transport.story.1.image",
        "characters": [
          "transport.momo",
          "transport.bunny"
        ],
        "mainWord": "en.bus.vehicle",
        "hotspots": [
          {
            "word": "en.bus.vehicle",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 和 Lulu 到车站等车，车还没来，两人一起耐心等待。",
        "segments": [
          {
            "id": "transport.story.1.intro",
            "text": "Momo and Lulu arrive at the bus stop.",
            "cn": "Momo 和 Lulu 来到公交车站。",
            "speaker": "narrator",
            "audio": "transport.story.1.intro.audio"
          },
          {
            "id": "transport.story.1.item",
            "text": "Is our bus here yet?",
            "cn": "我们的车来了吗？",
            "speaker": "momo",
            "audio": "transport.story.1.item.audio"
          },
          {
            "id": "transport.story.1.reply",
            "text": "Not yet. Let us wait together.",
            "cn": "还没有。我们一起等吧。",
            "speaker": "bunny",
            "audio": "transport.story.1.reply.audio"
          },
          {
            "id": "transport.story.1.more1",
            "text": "How long do we wait?",
            "cn": "我们要等多久？",
            "speaker": "momo",
            "audio": "transport.story.1.more1.audio"
          },
          {
            "id": "transport.story.1.more2",
            "text": "Not long. Look down the road.",
            "cn": "不会太久。往路那头看看。",
            "speaker": "bunny",
            "audio": "transport.story.1.more2.audio"
          }
        ]
      },
      {
        "id": "transport.story.2",
        "title": "2. 票放在哪里了",
        "templateId": "daily-life",
        "illustration": "transport.story.2.image",
        "characters": [
          "transport.momo",
          "transport.turtle"
        ],
        "mainWord": "en.ticket.travel",
        "hotspots": [
          {
            "word": "en.ticket.travel",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 找不到车票有些着急，Toto 提醒看看袋子的小口袋。",
        "segments": [
          {
            "id": "transport.story.2.intro",
            "text": "Momo looks inside the bag.",
            "cn": "Momo 在袋子里找来找去。",
            "speaker": "narrator",
            "audio": "transport.story.2.intro.audio"
          },
          {
            "id": "transport.story.2.item",
            "text": "I cannot find my ticket.",
            "cn": "我找不到我的车票了。",
            "speaker": "momo",
            "audio": "transport.story.2.item.audio"
          },
          {
            "id": "transport.story.2.reply",
            "text": "Check the small pocket. Take your time.",
            "cn": "看看那个小口袋。别着急。",
            "speaker": "turtle",
            "audio": "transport.story.2.reply.audio"
          },
          {
            "id": "transport.story.2.more1",
            "text": "Here it is! Thank you, Toto.",
            "cn": "找到了！谢谢你，Toto。",
            "speaker": "momo",
            "audio": "transport.story.2.more1.audio"
          }
        ]
      },
      {
        "id": "transport.story.3",
        "title": "3. 别把袋子落下",
        "templateId": "daily-life",
        "illustration": "transport.story.3.image",
        "characters": [
          "transport.fox",
          "transport.momo"
        ],
        "mainWord": "en.bag.container",
        "hotspots": [
          {
            "word": "en.bag.container",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "公交车来了，Fifi 想马上上车。Momo 提醒先拿好袋子。",
        "segments": [
          {
            "id": "transport.story.3.intro",
            "text": "The bus arrives at the stop.",
            "cn": "公交车到站了。",
            "speaker": "narrator",
            "audio": "transport.story.3.intro.audio"
          },
          {
            "id": "transport.story.3.item",
            "text": "Our bus is here! Let us go!",
            "cn": "我们的车来啦！走吧！",
            "speaker": "fox",
            "audio": "transport.story.3.item.audio"
          },
          {
            "id": "transport.story.3.reply",
            "text": "Wait. We need our bag too.",
            "cn": "等等，我们的袋子也要带上。",
            "speaker": "momo",
            "audio": "transport.story.3.reply.audio"
          },
          {
            "id": "transport.story.3.more1",
            "text": "Oh yes. Here is our bag.",
            "cn": "对哦。我们的袋子在这儿。",
            "speaker": "fox",
            "audio": "transport.story.3.more1.audio"
          }
        ]
      },
      {
        "id": "transport.story.4",
        "title": "4. 这个座位有人吗",
        "templateId": "daily-life",
        "illustration": "transport.story.4.image",
        "characters": [
          "transport.momo",
          "transport.bunny"
        ],
        "mainWord": "en.seat.furniture",
        "hotspots": [
          {
            "word": "en.seat.furniture",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "两人和大人一起上车，先问好座位是否有人，再坐在一起。",
        "segments": [
          {
            "id": "transport.story.4.intro",
            "text": "The friends step onto the bus with their grown-up.",
            "cn": "朋友们和大人一起上了车。",
            "speaker": "narrator",
            "audio": "transport.story.4.intro.audio"
          },
          {
            "id": "transport.story.4.item",
            "text": "Is this seat free?",
            "cn": "这个座位有人吗？",
            "speaker": "momo",
            "audio": "transport.story.4.item.audio"
          },
          {
            "id": "transport.story.4.reply",
            "text": "Yes. Let us sit beside each other.",
            "cn": "没人。我们坐在一起吧。",
            "speaker": "bunny",
            "audio": "transport.story.4.reply.audio"
          },
          {
            "id": "transport.story.4.more1",
            "text": "I can see out of the window.",
            "cn": "我能看到窗外。",
            "speaker": "momo",
            "audio": "transport.story.4.more1.audio"
          },
          {
            "id": "transport.story.4.more2",
            "text": "Look! A big tree.",
            "cn": "看！一棵大树。",
            "speaker": "bunny",
            "audio": "transport.story.4.more2.audio"
          }
        ]
      },
      {
        "id": "transport.story.5",
        "title": "5. 给过道留出地方",
        "templateId": "daily-life",
        "illustration": "transport.story.5.image",
        "characters": [
          "transport.fox",
          "transport.turtle"
        ],
        "mainWord": "en.bag.container",
        "hotspots": [
          {
            "word": "en.bag.container",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Fifi 的袋子放在过道上，Toto 提醒挪到脚边，不挡住别人。",
        "segments": [
          {
            "id": "transport.story.5.intro",
            "text": "A bag is in the aisle.",
            "cn": "过道上放着一个袋子。",
            "speaker": "narrator",
            "audio": "transport.story.5.intro.audio"
          },
          {
            "id": "transport.story.5.item",
            "text": "Where can I put my bag?",
            "cn": "我的袋子放在哪儿呢？",
            "speaker": "fox",
            "audio": "transport.story.5.item.audio"
          },
          {
            "id": "transport.story.5.reply",
            "text": "Keep it beside your feet. Leave the aisle clear.",
            "cn": "放在你脚边，别挡住过道。",
            "speaker": "turtle",
            "audio": "transport.story.5.reply.audio"
          },
          {
            "id": "transport.story.5.more1",
            "text": "Okay. Now people can walk by.",
            "cn": "好的。现在大家能走过去了。",
            "speaker": "fox",
            "audio": "transport.story.5.more1.audio"
          }
        ]
      },
      {
        "id": "transport.story.6",
        "title": "6. 到站再走",
        "templateId": "daily-life",
        "illustration": "transport.story.6.image",
        "characters": [
          "transport.momo",
          "transport.bunny"
        ],
        "mainWord": "en.bus.vehicle",
        "hotspots": [
          {
            "word": "en.bus.vehicle",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "到站停稳了，两人检查袋子和车票，跟着大人一起下车。",
        "segments": [
          {
            "id": "transport.story.6.intro",
            "text": "The bus stops at their destination.",
            "cn": "公交车到了他们要去的地方。",
            "speaker": "narrator",
            "audio": "transport.story.6.intro.audio"
          },
          {
            "id": "transport.story.6.item",
            "text": "Our stop! Bag and ticket ready?",
            "cn": "我们到站了！袋子和车票拿好了吗？",
            "speaker": "momo",
            "audio": "transport.story.6.item.audio"
          },
          {
            "id": "transport.story.6.reply",
            "text": "Ready. Let us leave with our grown-up.",
            "cn": "拿好了。我们跟大人一起下车吧。",
            "speaker": "bunny",
            "audio": "transport.story.6.reply.audio"
          },
          {
            "id": "transport.story.6.more1",
            "text": "Thank you, bus driver!",
            "cn": "谢谢司机！",
            "speaker": "momo",
            "audio": "transport.story.6.more1.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "transport.dialogue.1",
        "cn": "我们的车来了吗？",
        "question": [
          {
            "id": "transport.dialogue.1.question",
            "text": "Is our bus here yet?",
            "audio": "transport.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "transport.dialogue.1.reply.1",
            "text": "Not yet. Let us wait.",
            "cn": "还没有，我们等等。",
            "image": "transport.bus.image",
            "audio": "transport.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "transport.dialogue.1.reply.1.follow",
                "text": "We can wait together at the stop.",
                "audio": "transport.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "transport.dialogue.1.reply.2",
            "text": "Please stay with me.",
            "cn": "请陪着我。",
            "image": "transport.bus.image",
            "audio": "transport.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "transport.dialogue.1.reply.2.follow",
                "text": "I will stay beside you.",
                "audio": "transport.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "transport.dialogue.2",
        "cn": "你的车票在哪里？",
        "question": [
          {
            "id": "transport.dialogue.2.question",
            "text": "Where is your ticket?",
            "audio": "transport.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "transport.dialogue.2.reply.1",
            "text": "In my bag.",
            "cn": "在我的袋子里。",
            "image": "transport.ticket.image",
            "audio": "transport.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "transport.dialogue.2.reply.1.follow",
                "text": "Check the small pocket.",
                "audio": "transport.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "transport.dialogue.2.reply.2",
            "text": "Please help me look.",
            "cn": "请帮我找找。",
            "image": "transport.ticket.image",
            "audio": "transport.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "transport.dialogue.2.reply.2.follow",
                "text": "Take your time. We can look together.",
                "audio": "transport.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "transport.dialogue.3",
        "cn": "车来了，东西都拿好了吗？",
        "question": [
          {
            "id": "transport.dialogue.3.question",
            "text": "The bus is here. Have we got everything?",
            "audio": "transport.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "transport.dialogue.3.reply.1",
            "text": "Our bag and ticket!",
            "cn": "袋子和车票！",
            "image": "transport.bag.image",
            "audio": "transport.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "transport.dialogue.3.reply.1.follow",
                "text": "Now we can go with our grown-up.",
                "audio": "transport.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "transport.dialogue.3.reply.2",
            "text": "Wait for my bag, please.",
            "cn": "请等等，我拿袋子。",
            "image": "transport.bag.image",
            "audio": "transport.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "transport.dialogue.3.reply.2.follow",
                "text": "We can wait while you pick it up.",
                "audio": "transport.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "transport.dialogue.4",
        "cn": "这个座位空着吗？",
        "question": [
          {
            "id": "transport.dialogue.4.question",
            "text": "Is this seat free?",
            "audio": "transport.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "transport.dialogue.4.reply.1",
            "text": "Yes. Sit here, please.",
            "cn": "空着，请坐这里。",
            "image": "transport.seat.image",
            "audio": "transport.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "transport.dialogue.4.reply.1.follow",
                "text": "Thank you. We can sit beside each other.",
                "audio": "transport.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "transport.dialogue.4.reply.2",
            "text": "Let us ask first.",
            "cn": "我们先问问。",
            "image": "transport.seat.image",
            "audio": "transport.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "transport.dialogue.4.reply.2.follow",
                "text": "Good idea. Ask before we sit.",
                "audio": "transport.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "transport.dialogue.5",
        "cn": "我们的袋子放在哪里？",
        "question": [
          {
            "id": "transport.dialogue.5.question",
            "text": "Where can we keep our bag?",
            "audio": "transport.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "transport.dialogue.5.reply.1",
            "text": "Beside our feet.",
            "cn": "放在脚边。",
            "image": "transport.bag.image",
            "audio": "transport.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "transport.dialogue.5.reply.1.follow",
                "text": "Then the aisle will stay clear.",
                "audio": "transport.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "transport.dialogue.5.reply.2",
            "text": "Help me move it, please.",
            "cn": "请帮我挪一下。",
            "image": "transport.bag.image",
            "audio": "transport.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "transport.dialogue.5.reply.2.follow",
                "text": "We can move it together.",
                "audio": "transport.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "transport.dialogue.6",
        "cn": "车停稳了，我们下车吗？",
        "question": [
          {
            "id": "transport.dialogue.6.question",
            "text": "The bus has stopped. Shall we leave?",
            "audio": "transport.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "transport.dialogue.6.reply.1",
            "text": "Yes, with our grown-up.",
            "cn": "好，和大人一起。",
            "image": "transport.ticket.image",
            "audio": "transport.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "transport.dialogue.6.reply.1.follow",
                "text": "Take your bag and ticket with you.",
                "audio": "transport.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "transport.dialogue.6.reply.2",
            "text": "Please wait for me.",
            "cn": "请等等我。",
            "image": "transport.bag.image",
            "audio": "transport.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "transport.dialogue.6.reply.2.follow",
                "text": "We will stay together.",
