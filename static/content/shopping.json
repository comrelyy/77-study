  "modules": {
    "story": [
      {
        "id": "shopping.story.1",
        "title": "1. 清单还没看呢",
        "templateId": "daily-life",
        "illustration": "shopping.story.1.image",
        "characters": [
          "shopping.momo",
          "shopping.bunny"
        ],
        "mainWord": "en.bag.container",
        "hotspots": [
          {
            "word": "en.bag.container",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 想买好多水果。Lulu 提醒先带上袋子，再和大人一起看清单。",
        "segments": [
          {
            "id": "shopping.story.1.intro",
            "text": "Momo picks up the shopping bag.",
            "cn": "Momo 拿起购物袋。",
            "speaker": "narrator",
            "audio": "shopping.story.1.intro.audio"
          },
          {
            "id": "shopping.story.1.item",
            "text": "Let us buy lots of fruit!",
            "cn": "我们去买好多水果吧！",
            "speaker": "momo",
            "audio": "shopping.story.1.item.audio"
          },
          {
            "id": "shopping.story.1.reply",
            "text": "First, let us read our list.",
            "cn": "我们先看看购物清单。",
            "speaker": "bunny",
            "audio": "shopping.story.1.reply.audio"
          },
          {
            "id": "shopping.story.1.more1",
            "text": "What is on our list?",
            "cn": "我们的清单上有什么？",
            "speaker": "momo",
            "audio": "shopping.story.1.more1.audio"
          },
          {
            "id": "shopping.story.1.more2",
            "text": "An apple and a banana.",
            "cn": "一个苹果和一根香蕉。",
            "speaker": "bunny",
            "audio": "shopping.story.1.more2.audio"
          }
        ]
      },
      {
        "id": "shopping.story.2",
        "title": "2. 只要一个苹果",
        "templateId": "daily-life",
        "illustration": "shopping.story.2.image",
        "characters": [
          "shopping.momo",
          "shopping.bunny"
        ],
        "mainWord": "en.apple.fruit",
        "hotspots": [
          {
            "word": "en.apple.fruit",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "架子上有很多苹果。Lulu 和 Momo 对照清单，选出需要的一个。",
        "segments": [
          {
            "id": "shopping.story.2.intro",
            "text": "There are many apples on the shelf.",
            "cn": "架子上有好多苹果。",
            "speaker": "narrator",
            "audio": "shopping.story.2.intro.audio"
          },
          {
            "id": "shopping.story.2.item",
            "text": "Two apples? Three?",
            "cn": "两个苹果？三个？",
            "speaker": "momo",
            "audio": "shopping.story.2.item.audio"
          },
          {
            "id": "shopping.story.2.reply",
            "text": "Our list says one. Let us choose one.",
            "cn": "清单上写着一个。我们挑一个吧。",
            "speaker": "bunny",
            "audio": "shopping.story.2.reply.audio"
          },
          {
            "id": "shopping.story.2.more1",
            "text": "This one looks good.",
            "cn": "这个看起来不错。",
            "speaker": "momo",
            "audio": "shopping.story.2.more1.audio"
          }
        ]
      },
      {
        "id": "shopping.story.3",
        "title": "3. 香蕉在哪里",
        "templateId": "daily-life",
        "illustration": "shopping.story.3.image",
        "characters": [
          "shopping.bunny",
          "shopping.momo"
        ],
        "mainWord": "en.banana.fruit",
        "hotspots": [
          {
            "word": "en.banana.fruit",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Lulu 一开始没看到香蕉。Momo 换个方向观察，在苹果旁边找到了。",
        "segments": [
          {
            "id": "shopping.story.3.intro",
            "text": "The banana shelf looks empty at first.",
            "cn": "香蕉架子一开始看起来空空的。",
            "speaker": "narrator",
            "audio": "shopping.story.3.intro.audio"
          },
          {
            "id": "shopping.story.3.item",
            "text": "I cannot find a banana.",
            "cn": "我找不到香蕉。",
            "speaker": "bunny",
            "audio": "shopping.story.3.item.audio"
          },
          {
            "id": "shopping.story.3.reply",
            "text": "Look beside the apples. There is one!",
            "cn": "看看苹果旁边。那儿有一根！",
            "speaker": "momo",
            "audio": "shopping.story.3.reply.audio"
          },
          {
            "id": "shopping.story.3.more1",
            "text": "You have good eyes, Momo!",
            "cn": "你的眼睛真尖，Momo！",
            "speaker": "bunny",
            "audio": "shopping.story.3.more1.audio"
          }
        ]
      },
      {
        "id": "shopping.story.4",
        "title": "4. 轮到我们付钱",
        "templateId": "daily-life",
        "illustration": "shopping.story.4.image",
        "characters": [
          "shopping.momo",
          "shopping.bunny"
        ],
        "mainWord": "en.coin.money",
        "hotspots": [
          {
            "word": "en.coin.money",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "大人保管着付款的硬币。前面还有人，两人一起等候轮到自己。",
        "segments": [
          {
            "id": "shopping.story.4.intro",
            "text": "A grown-up keeps the coin for paying.",
            "cn": "大人拿着付钱用的硬币。",
            "speaker": "narrator",
            "audio": "shopping.story.4.intro.audio"
          },
          {
            "id": "shopping.story.4.item",
            "text": "Is it our turn?",
            "cn": "轮到我们了吗？",
            "speaker": "momo",
            "audio": "shopping.story.4.item.audio"
          },
          {
            "id": "shopping.story.4.reply",
            "text": "Not yet. We can wait here together.",
            "cn": "还没有。我们在这儿一起等。",
            "speaker": "bunny",
            "audio": "shopping.story.4.reply.audio"
          },
          {
            "id": "shopping.story.4.more1",
            "text": "Now it is our turn.",
            "cn": "现在轮到我们了。",
            "speaker": "momo",
            "audio": "shopping.story.4.more1.audio"
          },
          {
            "id": "shopping.story.4.more2",
            "text": "Thank you for waiting with me.",
            "cn": "谢谢你陪我一起等。",
            "speaker": "bunny",
            "audio": "shopping.story.4.more2.audio"
          }
        ]
      },
      {
        "id": "shopping.story.5",
        "title": "5. 袋子不要装太满",
        "templateId": "daily-life",
        "illustration": "shopping.story.5.image",
        "characters": [
          "shopping.bunny",
          "shopping.momo"
        ],
        "mainWord": "en.bag.container",
        "hotspots": [
          {
            "word": "en.bag.container",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "水果装好后，Lulu 觉得袋子有些重。Momo 主动帮忙，两人一起拿。",
        "segments": [
          {
            "id": "shopping.story.5.intro",
            "text": "The fruit goes into the bag.",
            "cn": "水果装进了袋子。",
            "speaker": "narrator",
            "audio": "shopping.story.5.intro.audio"
          },
          {
            "id": "shopping.story.5.item",
            "text": "This bag feels heavy.",
            "cn": "这个袋子好重。",
            "speaker": "bunny",
            "audio": "shopping.story.5.item.audio"
          },
          {
            "id": "shopping.story.5.reply",
            "text": "I can help you carry it.",
            "cn": "我可以帮你一起拿。",
            "speaker": "momo",
            "audio": "shopping.story.5.reply.audio"
          },
          {
            "id": "shopping.story.5.more1",
            "text": "Thank you. It is easy with two.",
            "cn": "谢谢你。两个人拿就轻松了。",
            "speaker": "bunny",
            "audio": "shopping.story.5.more1.audio"
          }
        ]
      },
      {
        "id": "shopping.story.6",
        "title": "6. 回家一起分享",
        "templateId": "daily-life",
        "illustration": "shopping.story.6.image",
        "characters": [
          "shopping.momo",
          "shopping.bunny"
        ],
        "mainWord": "en.apple.fruit",
        "hotspots": [
          {
            "word": "en.apple.fruit",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "回到家，朋友们检查买回的苹果和香蕉，准备一起分享。",
        "segments": [
          {
            "id": "shopping.story.6.intro",
            "text": "The friends arrive home with their fruit.",
            "cn": "朋友们带着水果回到家。",
            "speaker": "narrator",
            "audio": "shopping.story.6.intro.audio"
          },
          {
            "id": "shopping.story.6.item",
            "text": "One apple and one banana. We did it!",
            "cn": "一个苹果和一根香蕉。我们做到啦！",
            "speaker": "momo",
            "audio": "shopping.story.6.item.audio"
          },
          {
            "id": "shopping.story.6.reply",
            "text": "Now let us share them.",
            "cn": "现在我们来分着吃吧。",
            "speaker": "bunny",
            "audio": "shopping.story.6.reply.audio"
          },
          {
            "id": "shopping.story.6.more1",
            "text": "Here is your half.",
            "cn": "这是你的一半。",
            "speaker": "momo",
            "audio": "shopping.story.6.more1.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "shopping.dialogue.1",
        "cn": "去商店要带什么呢？",
        "question": [
          {
            "id": "shopping.dialogue.1.question",
            "text": "What shall we bring to the shop?",
            "audio": "shopping.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "shopping.dialogue.1.reply.1",
            "text": "Our bag, please.",
            "cn": "带上我们的袋子。",
            "image": "shopping.bag.image",
            "audio": "shopping.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.1.reply.1.follow",
                "text": "We can use it to carry our fruit.",
                "audio": "shopping.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "shopping.dialogue.1.reply.2",
            "text": "Help me read the list.",
            "cn": "帮我看看清单。",
            "image": "shopping.bag.image",
            "audio": "shopping.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.1.reply.2.follow",
                "text": "Let us read it with our grown-up.",
                "audio": "shopping.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "shopping.dialogue.2",
        "cn": "你先想拿什么水果？",
        "question": [
          {
            "id": "shopping.dialogue.2.question",
            "text": "What fruit would you like first?",
            "audio": "shopping.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "shopping.dialogue.2.reply.1",
            "text": "An apple, please.",
            "cn": "请给我一个苹果。",
            "image": "shopping.apple.image",
            "audio": "shopping.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.2.reply.1.follow",
                "text": "Let us choose one apple from the shelf.",
                "audio": "shopping.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "shopping.dialogue.2.reply.2",
            "text": "A banana, please.",
            "cn": "请给我一根香蕉。",
            "image": "shopping.banana.image",
            "audio": "shopping.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.2.reply.2.follow",
                "text": "Let us look on the next shelf.",
                "audio": "shopping.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "shopping.dialogue.3",
        "cn": "清单上要几个苹果？",
        "question": [
          {
            "id": "shopping.dialogue.3.question",
            "text": "How many apples are on our list?",
            "audio": "shopping.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "shopping.dialogue.3.reply.1",
            "text": "One apple, please.",
            "cn": "请拿一个苹果。",
            "image": "shopping.apple.image",
            "audio": "shopping.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.3.reply.1.follow",
                "text": "One apple. That is what our list says.",
                "audio": "shopping.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "shopping.dialogue.3.reply.2",
            "text": "Let us check together.",
            "cn": "我们一起检查。",
            "image": "shopping.apple.image",
            "audio": "shopping.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.3.reply.2.follow",
                "text": "Our grown-up can help us read the list.",
                "audio": "shopping.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "shopping.dialogue.4",
        "cn": "我们找到香蕉了吗？",
        "question": [
          {
            "id": "shopping.dialogue.4.question",
            "text": "Have we found the banana?",
            "audio": "shopping.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "shopping.dialogue.4.reply.1",
            "text": "Yes, here it is.",
            "cn": "找到了，在这里。",
            "image": "shopping.banana.image",
            "audio": "shopping.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.4.reply.1.follow",
                "text": "We have both kinds of fruit now.",
                "audio": "shopping.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "shopping.dialogue.4.reply.2",
            "text": "Please help me find it.",
            "cn": "请帮我找一找。",
            "image": "shopping.banana.image",
            "audio": "shopping.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.4.reply.2.follow",
                "text": "Look beside the apples. I will help you.",
                "audio": "shopping.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "shopping.dialogue.5",
        "cn": "谁来保管付款的硬币呢？",
        "question": [
          {
            "id": "shopping.dialogue.5.question",
            "text": "Who will keep the coin for paying?",
            "audio": "shopping.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "shopping.dialogue.5.reply.1",
            "text": "Our grown-up will.",
            "cn": "让大人保管。",
            "image": "shopping.coin.image",
            "audio": "shopping.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.5.reply.1.follow",
                "text": "We can watch our grown-up pay.",
                "audio": "shopping.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "shopping.dialogue.5.reply.2",
            "text": "Let us ask our grown-up.",
            "cn": "我们问问大人。",
            "image": "shopping.coin.image",
            "audio": "shopping.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "shopping.dialogue.5.reply.2.follow",
                "text": "They will help us pay the shopkeeper.",
                "audio": "shopping.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "shopping.dialogue.6",
        "cn": "我们对店员说什么呢？",
        "question": [
          {
            "id": "shopping.dialogue.6.question",
            "text": "What shall we say to the shopkeeper?",
            "audio": "shopping.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "shopping.dialogue.6.reply.1",
            "text": "Thank you. Goodbye!",
