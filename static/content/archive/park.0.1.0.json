    {
      "id": "park.dialogue.1.question.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.1.question.audio.wav",
      "text": "What can you see above us?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.1.reply.1.audio.wav",
      "text": "I can see a tree.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.1.reply.1.follow.audio.wav",
      "text": "Its leaves make a shady spot for us.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.1.reply.2.audio.wav",
      "text": "Let us look together.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.1.reply.2.follow.audio.wav",
      "text": "Look up beside me. There are green leaves.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.2.question.audio.wav",
      "text": "Shall we look at this flower?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.2.reply.1.audio.wav",
      "text": "Yes! Leave it growing.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.2.reply.1.follow.audio.wav",
      "text": "We can enjoy it without picking it.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.2.reply.2.audio.wav",
      "text": "Let us look from here.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.2.reply.2.follow.audio.wav",
      "text": "This is a good place to look.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.3.question.audio.wav",
      "text": "Can you hear the bird?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.3.reply.1.audio.wav",
      "text": "Yes! Up in the tree.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.3.reply.1.follow.audio.wav",
      "text": "Let us stay quiet and listen.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.3.reply.2.audio.wav",
      "text": "Please wait. I am listening.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.3.reply.2.follow.audio.wav",
      "text": "We can listen together for a moment.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.4.question.audio.wav",
      "text": "Would you like to roll the ball?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.4.reply.1.audio.wav",
      "text": "Yes! My turn, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.4.reply.1.follow.audio.wav",
      "text": "Here comes the ball. Roll it back when ready.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.4.reply.2.audio.wav",
      "text": "You go first.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.4.reply.2.follow.audio.wav",
      "text": "I will roll it gently towards you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.5.question.audio.wav",
      "text": "Our ball rolled away. What can we do?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.5.reply.1.audio.wav",
      "text": "Ask our grown-up for help.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.5.reply.1.follow.audio.wav",
      "text": "We will stay here together while they help.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.5.reply.2.audio.wav",
      "text": "Please stay with me.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.5.reply.2.follow.audio.wav",
      "text": "I will stay beside you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.6.question.audio.wav",
      "text": "What shall we say before we leave?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.6.reply.1.audio.wav",
      "text": "Goodbye, bird!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.6.reply.1.follow.audio.wav",
      "text": "We can visit the park another day.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.6.reply.2.audio.wav",
      "text": "Goodbye, tree and flower!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "park.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/park/v0-1-0/park.dialogue.6.reply.2.follow.audio.wav",
      "text": "Thank you for a lovely afternoon.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
