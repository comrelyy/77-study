  "modules": {
    "story": [
      {
        "id": "park.story.1",
        "title": "1. 树下有个好地方",
        "templateId": "daily-life",
        "illustration": "park.story.1.image",
        "characters": [
          "park.momo",
          "park.bunny"
        ],
        "mainWord": "en.tree.plant",
        "hotspots": [
          {
            "word": "en.tree.plant",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "到了公园，太阳有点晒。Lulu 找到大树下的阴凉处。",
        "segments": [
          {
            "id": "park.story.1.intro",
            "text": "The friends arrive at the park.",
            "speaker": "narrator",
            "audio": "park.story.1.intro.audio"
          },
          {
            "id": "park.story.1.item",
            "text": "It is sunny. Where can we sit?",
            "speaker": "momo",
            "audio": "park.story.1.item.audio"
          },
          {
            "id": "park.story.1.reply",
            "text": "Under this tree. There is shade.",
            "speaker": "bunny",
            "audio": "park.story.1.reply.audio"
          }
        ]
      },
      {
        "id": "park.story.2",
        "title": "2. 花留在这里吧",
        "templateId": "daily-life",
        "illustration": "park.story.2.image",
        "characters": [
          "park.momo",
          "park.bunny"
        ],
        "mainWord": "en.flower.plant",
        "hotspots": [
          {
            "word": "en.flower.plant",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 想把花带回家，Lulu 提议让它继续长，下次还可以来看。",
        "segments": [
          {
            "id": "park.story.2.intro",
            "text": "A flower grows beside the path.",
            "speaker": "narrator",
            "audio": "park.story.2.intro.audio"
          },
          {
            "id": "park.story.2.item",
            "text": "Can we take it home?",
            "speaker": "momo",
            "audio": "park.story.2.item.audio"
          },
          {
            "id": "park.story.2.reply",
            "text": "Let it grow. We can visit again.",
            "speaker": "bunny",
            "audio": "park.story.2.reply.audio"
          }
        ]
      },
      {
        "id": "park.story.3",
        "title": "3. 先停下来听一听",
        "templateId": "daily-life",
        "illustration": "park.story.3.image",
        "characters": [
          "park.bunny",
          "park.momo"
        ],
        "mainWord": "en.bird.animal",
        "hotspots": [
          {
            "word": "en.bird.animal",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "树上有小鸟唱歌。两人停下来，安静地听一会儿。",
        "segments": [
          {
            "id": "park.story.3.intro",
            "text": "A bird sings in the tree.",
            "speaker": "narrator",
            "audio": "park.story.3.intro.audio"
          },
          {
            "id": "park.story.3.item",
            "text": "Can you hear that?",
            "speaker": "bunny",
            "audio": "park.story.3.item.audio"
          },
          {
            "id": "park.story.3.reply",
            "text": "Yes! Let us be quiet and listen.",
            "speaker": "momo",
            "audio": "park.story.3.reply.audio"
          }
        ]
      },
      {
        "id": "park.story.4",
        "title": "4. 我们轮流来",
        "templateId": "daily-life",
        "illustration": "park.story.4.image",
        "characters": [
          "park.bunny",
          "park.momo"
        ],
        "mainWord": "en.ball.toy",
        "hotspots": [
          {
            "word": "en.ball.toy",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 抱着球玩了好一会儿。Lulu 表达也想玩，Momo 把球滚给朋友。",
        "segments": [
          {
            "id": "park.story.4.intro",
            "text": "Momo holds the ball for a long time.",
            "speaker": "narrator",
            "audio": "park.story.4.intro.audio"
          },
          {
            "id": "park.story.4.item",
            "text": "May I have a turn?",
            "speaker": "bunny",
            "audio": "park.story.4.item.audio"
          },
          {
            "id": "park.story.4.reply",
            "text": "Yes. I roll it to you. Your turn!",
            "speaker": "momo",
            "audio": "park.story.4.reply.audio"
          }
        ]
      },
      {
        "id": "park.story.5",
        "title": "5. 球滚到路边了",
        "templateId": "daily-life",
        "illustration": "park.story.5.image",
        "characters": [
          "park.momo",
          "park.bunny"
        ],
        "mainWord": "en.ball.toy",
        "hotspots": [
          {
            "word": "en.ball.toy",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "球滚到了路边。Momo 想去追，Lulu 请朋友留在身边，一起请大人帮忙。",
        "segments": [
          {
            "id": "park.story.5.intro",
            "text": "The ball rolls beside the path.",
            "speaker": "narrator",
            "audio": "park.story.5.intro.audio"
          },
          {
            "id": "park.story.5.item",
            "text": "I want to run after it!",
            "speaker": "momo",
            "audio": "park.story.5.item.audio"
          },
          {
            "id": "park.story.5.reply",
            "text": "Stay with me. Let us ask for help.",
            "speaker": "bunny",
            "audio": "park.story.5.reply.audio"
          }
        ]
      },
      {
        "id": "park.story.6",
        "title": "6. 和公园说再见",
        "templateId": "daily-life",
        "illustration": "park.story.6.image",
        "characters": [
          "park.momo",
          "park.bunny"
        ],
        "mainWord": "en.bird.animal",
        "hotspots": [
          {
            "word": "en.bird.animal",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "离开前，两人向小鸟和大树道别，约好下次再带球来玩。",
        "segments": [
          {
            "id": "park.story.6.intro",
            "text": "It is time to leave the park.",
            "speaker": "narrator",
            "audio": "park.story.6.intro.audio"
          },
          {
            "id": "park.story.6.item",
            "text": "Goodbye, bird. Goodbye, tree!",
            "speaker": "momo",
            "audio": "park.story.6.item.audio"
          },
          {
            "id": "park.story.6.reply",
            "text": "We can bring our ball another day.",
            "speaker": "bunny",
            "audio": "park.story.6.reply.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "park.dialogue.1",
        "cn": "你能看见我们上方有什么？",
        "question": [
          {
            "id": "park.dialogue.1.question",
            "text": "What can you see above us?",
            "audio": "park.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "park.dialogue.1.reply.1",
            "text": "I can see a tree.",
            "cn": "我能看见一棵树。",
            "image": "park.tree.image",
            "audio": "park.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "park.dialogue.1.reply.1.follow",
                "text": "Its leaves make a shady spot for us.",
                "audio": "park.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "park.dialogue.1.reply.2",
            "text": "Let us look together.",
            "cn": "我们一起看看。",
            "image": "park.tree.image",
            "audio": "park.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "park.dialogue.1.reply.2.follow",
                "text": "Look up beside me. There are green leaves.",
                "audio": "park.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "park.dialogue.2",
        "cn": "我们看看这朵花好吗？",
        "question": [
          {
            "id": "park.dialogue.2.question",
            "text": "Shall we look at this flower?",
            "audio": "park.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "park.dialogue.2.reply.1",
            "text": "Yes! Leave it growing.",
            "cn": "好呀，让它继续长。",
            "image": "park.flower.image",
            "audio": "park.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "park.dialogue.2.reply.1.follow",
                "text": "We can enjoy it without picking it.",
                "audio": "park.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "park.dialogue.2.reply.2",
            "text": "Let us look from here.",
            "cn": "我们在这里看吧。",
            "image": "park.flower.image",
            "audio": "park.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "park.dialogue.2.reply.2.follow",
                "text": "This is a good place to look.",
                "audio": "park.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "park.dialogue.3",
        "cn": "你能听见小鸟吗？",
        "question": [
          {
            "id": "park.dialogue.3.question",
            "text": "Can you hear the bird?",
            "audio": "park.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "park.dialogue.3.reply.1",
            "text": "Yes! Up in the tree.",
            "cn": "能，在树上。",
            "image": "park.bird.image",
            "audio": "park.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "park.dialogue.3.reply.1.follow",
                "text": "Let us stay quiet and listen.",
                "audio": "park.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "park.dialogue.3.reply.2",
            "text": "Please wait. I am listening.",
            "cn": "等等，我在听。",
            "image": "park.bird.image",
            "audio": "park.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "park.dialogue.3.reply.2.follow",
                "text": "We can listen together for a moment.",
                "audio": "park.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "park.dialogue.4",
        "cn": "你想滚球吗？",
        "question": [
          {
            "id": "park.dialogue.4.question",
            "text": "Would you like to roll the ball?",
            "audio": "park.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "park.dialogue.4.reply.1",
            "text": "Yes! My turn, please.",
            "cn": "想，请轮到我。",
            "image": "park.ball.image",
            "audio": "park.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "park.dialogue.4.reply.1.follow",
                "text": "Here comes the ball. Roll it back when ready.",
                "audio": "park.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "park.dialogue.4.reply.2",
            "text": "You go first.",
            "cn": "你先来。",
            "image": "park.ball.image",
            "audio": "park.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "park.dialogue.4.reply.2.follow",
                "text": "I will roll it gently towards you.",
                "audio": "park.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "park.dialogue.5",
        "cn": "球滚远了，我们怎么办？",
        "question": [
          {
            "id": "park.dialogue.5.question",
            "text": "Our ball rolled away. What can we do?",
            "audio": "park.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "park.dialogue.5.reply.1",
            "text": "Ask our grown-up for help.",
            "cn": "请大人帮忙。",
            "image": "park.ball.image",
            "audio": "park.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "park.dialogue.5.reply.1.follow",
                "text": "We will stay here together while they help.",
                "audio": "park.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "park.dialogue.5.reply.2",
            "text": "Please stay with me.",
            "cn": "请陪着我。",
            "image": "park.ball.image",
            "audio": "park.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "park.dialogue.5.reply.2.follow",
                "text": "I will stay beside you.",
                "audio": "park.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "park.dialogue.6",
        "cn": "离开前我们说什么呢？",
        "question": [
          {
            "id": "park.dialogue.6.question",
            "text": "What shall we say before we leave?",
            "audio": "park.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "park.dialogue.6.reply.1",
            "text": "Goodbye, bird!",
            "cn": "再见，小鸟！",
            "image": "park.bird.image",
            "audio": "park.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "park.dialogue.6.reply.1.follow",
                "text": "We can visit the park another day.",
                "audio": "park.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "park.dialogue.6.reply.2",
            "text": "Goodbye, tree and flower!",
            "cn": "再见，大树和花朵！",
            "image": "park.tree.image",
            "audio": "park.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "park.dialogue.6.reply.2.follow",
                "text": "Thank you for a lovely afternoon.",
                "audio": "park.dialogue.6.reply.2.follow.audio"
              }
            ]
          }
        ]
      }
    ],
