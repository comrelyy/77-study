      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.1.question.audio.wav",
      "text": "Would you like some bread?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.1.reply.1.audio.wav",
      "text": "Some bread, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.1.reply.1.follow.audio.wav",
      "text": "Here is a piece for you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.1.reply.2.audio.wav",
      "text": "No, thank you.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.1.reply.2.follow.audio.wav",
      "text": "That is okay. You can choose something else.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.2.question.audio.wav",
      "text": "What would you like in your cup?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.2.reply.1.audio.wav",
      "text": "A little milk, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.2.reply.1.follow.audio.wav",
      "text": "Our grown-up can help us pour it.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.2.reply.2.audio.wav",
      "text": "No milk, thank you.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.2.reply.2.follow.audio.wav",
      "text": "That is okay. Tell our grown-up what you need.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.3.question.audio.wav",
      "text": "Shall we share this bread?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.3.reply.1.audio.wav",
      "text": "Yes, a small piece, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.3.reply.1.follow.audio.wav",
      "text": "I will put your piece on your plate.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.3.reply.2.audio.wav",
      "text": "I have enough, thank you.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.3.reply.2.follow.audio.wav",
      "text": "You can stop whenever you have had enough.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.4.question.audio.wav",
      "text": "Would you like the egg now?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.4.reply.1.audio.wav",
      "text": "Is it too hot?",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.4.reply.1.follow.audio.wav",
      "text": "Let us check with our grown-up first.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.4.reply.2.audio.wav",
      "text": "I will wait a little.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.4.reply.2.follow.audio.wav",
      "text": "We can wait until it is comfortable to eat.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.5.question.audio.wav",
      "text": "Can you pass the cup, please?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.5.reply.1.audio.wav",
      "text": "Here you are.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.5.reply.1.follow.audio.wav",
      "text": "Thank you. I will hold it with both hands.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.5.reply.2.audio.wav",
      "text": "Please help me carry it.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.5.reply.2.follow.audio.wav",
      "text": "Let us carry it carefully together.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.6.question.audio.wav",
      "text": "Have you had enough breakfast?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.6.reply.1.audio.wav",
      "text": "Yes, thank you.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.6.reply.1.follow.audio.wav",
      "text": "Let us put our things away.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/breakfast/v0-1-0/breakfast.dialogue.6.reply.2.audio.wav",
      "text": "A little more bread, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "breakfast.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
