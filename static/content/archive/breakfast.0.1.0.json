        ],
        "translation": "早餐吃饱了，我们请人帮忙把杯子收回去。",
        "segments": [
          {
            "id": "breakfast.story.5.intro",
            "text": "We have had enough breakfast.",
            "audio": "breakfast.story.5.intro.audio"
          },
          {
            "id": "breakfast.story.5.item",
            "text": "We carry our cup back with help.",
            "audio": "breakfast.story.5.item.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "breakfast.dialogue.1",
        "cn": "你想吃一点面包吗？",
        "question": [
          {
            "id": "breakfast.dialogue.1.question",
            "text": "Would you like some bread?",
            "audio": "breakfast.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "breakfast.dialogue.1.reply.1",
            "text": "Some bread, please.",
            "cn": "请给我一点面包。",
            "image": "breakfast.bread.image",
            "audio": "breakfast.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.1.reply.1.follow",
                "text": "Here is a piece for you.",
                "audio": "breakfast.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "breakfast.dialogue.1.reply.2",
            "text": "No, thank you.",
            "cn": "不用了，谢谢。",
            "image": "breakfast.bread.image",
            "audio": "breakfast.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.1.reply.2.follow",
                "text": "That is okay. You can choose something else.",
                "audio": "breakfast.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "breakfast.dialogue.2",
        "cn": "你的杯子里想装什么？",
        "question": [
          {
            "id": "breakfast.dialogue.2.question",
            "text": "What would you like in your cup?",
            "audio": "breakfast.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "breakfast.dialogue.2.reply.1",
            "text": "A little milk, please.",
            "cn": "请给我一点牛奶。",
            "image": "breakfast.milk.image",
            "audio": "breakfast.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.2.reply.1.follow",
                "text": "Our grown-up can help us pour it.",
                "audio": "breakfast.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "breakfast.dialogue.2.reply.2",
            "text": "No milk, thank you.",
            "cn": "不喝牛奶，谢谢。",
            "image": "breakfast.cup.image",
            "audio": "breakfast.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.2.reply.2.follow",
                "text": "That is okay. Tell our grown-up what you need.",
                "audio": "breakfast.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "breakfast.dialogue.3",
        "cn": "我们分享这块面包好吗？",
        "question": [
          {
            "id": "breakfast.dialogue.3.question",
            "text": "Shall we share this bread?",
            "audio": "breakfast.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "breakfast.dialogue.3.reply.1",
            "text": "Yes, a small piece, please.",
            "cn": "好，请给我一小块。",
            "image": "breakfast.bread.image",
            "audio": "breakfast.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.3.reply.1.follow",
                "text": "I will put your piece on your plate.",
                "audio": "breakfast.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "breakfast.dialogue.3.reply.2",
            "text": "I have enough, thank you.",
            "cn": "我已经够了，谢谢。",
            "image": "breakfast.bread.image",
            "audio": "breakfast.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.3.reply.2.follow",
                "text": "You can stop whenever you have had enough.",
                "audio": "breakfast.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "breakfast.dialogue.4",
        "cn": "你现在想吃鸡蛋吗？",
        "question": [
          {
            "id": "breakfast.dialogue.4.question",
            "text": "Would you like the egg now?",
            "audio": "breakfast.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "breakfast.dialogue.4.reply.1",
            "text": "Is it too hot?",
            "cn": "它会不会太烫？",
            "image": "breakfast.egg.image",
            "audio": "breakfast.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.4.reply.1.follow",
                "text": "Let us check with our grown-up first.",
                "audio": "breakfast.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "breakfast.dialogue.4.reply.2",
            "text": "I will wait a little.",
            "cn": "我想等一会儿。",
            "image": "breakfast.egg.image",
            "audio": "breakfast.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.4.reply.2.follow",
                "text": "We can wait until it is comfortable to eat.",
                "audio": "breakfast.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "breakfast.dialogue.5",
        "cn": "你能递一下杯子吗？",
        "question": [
          {
            "id": "breakfast.dialogue.5.question",
            "text": "Can you pass the cup, please?",
            "audio": "breakfast.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "breakfast.dialogue.5.reply.1",
            "text": "Here you are.",
            "cn": "给你。",
            "image": "breakfast.cup.image",
            "audio": "breakfast.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.5.reply.1.follow",
                "text": "Thank you. I will hold it with both hands.",
                "audio": "breakfast.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "breakfast.dialogue.5.reply.2",
            "text": "Please help me carry it.",
            "cn": "请帮我拿过去。",
            "image": "breakfast.cup.image",
            "audio": "breakfast.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.5.reply.2.follow",
                "text": "Let us carry it carefully together.",
                "audio": "breakfast.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "breakfast.dialogue.6",
        "cn": "早餐吃够了吗？",
        "question": [
          {
            "id": "breakfast.dialogue.6.question",
            "text": "Have you had enough breakfast?",
            "audio": "breakfast.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "breakfast.dialogue.6.reply.1",
            "text": "Yes, thank you.",
            "cn": "够了，谢谢。",
            "image": "breakfast.cup.image",
            "audio": "breakfast.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.6.reply.1.follow",
                "text": "Let us put our things away.",
                "audio": "breakfast.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "breakfast.dialogue.6.reply.2",
            "text": "A little more bread, please.",
            "cn": "请再给我一点面包。",
            "image": "breakfast.bread.image",
            "audio": "breakfast.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "breakfast.dialogue.6.reply.2.follow",
                "text": "Here is another small piece.",
                "audio": "breakfast.dialogue.6.reply.2.follow.audio"
              }
            ]
          }
        ]
      }
    ],
