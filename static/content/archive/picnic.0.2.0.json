    "dialogue": [
      {
        "id": "picnic.dialogue.1",
        "cn": "小兔你好！我们一起野餐好吗？",
        "question": [
          {
            "id": "picnic.dialogue.1.question",
            "text": "Hello, Bunny! Shall we have a picnic?",
            "audio": "picnic.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.1.reply.1",
            "image": "picnic.bunny",
            "text": "Yes! Let us have a picnic.",
            "cn": "好呀，一起野餐！",
            "audio": "picnic.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.1.reply.1.follow",
                "text": "Great! I brought our basket.",
                "audio": "picnic.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.1.reply.2",
            "image": "picnic.wave",
            "text": "Can I join you?",
            "cn": "我可以加入吗？",
            "audio": "picnic.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.1.reply.2.follow",
                "text": "Of course! There is room for you.",
                "audio": "picnic.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "picnic.dialogue.2",
        "cn": "我们坐在哪里呢？",
        "question": [
          {
            "id": "picnic.dialogue.2.question",
            "text": "Where shall we sit?",
            "audio": "picnic.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.2.reply.1",
            "image": "picnic.basket",
            "text": "Let us sit here.",
            "cn": "我们坐在这里吧。",
            "audio": "picnic.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.2.reply.1.follow",
                "text": "Here is a lovely spot for our picnic.",
                "audio": "picnic.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.2.reply.2",
            "image": "picnic.momo",
            "text": "Next to you, please.",
            "cn": "我想坐在你旁边。",
            "audio": "picnic.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.2.reply.2.follow",
                "text": "Come and sit beside me.",
                "audio": "picnic.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "picnic.dialogue.3",
        "cn": "你想从篮子里拿什么？",
        "question": [
          {
            "id": "picnic.dialogue.3.question",
            "text": "What would you like from our basket?",
            "audio": "picnic.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.3.reply.1",
            "image": "picnic.apple.image",
            "text": "An apple, please.",
            "cn": "请给我一个苹果。",
            "audio": "picnic.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.3.reply.1.follow",
                "text": "Here is your apple.",
                "audio": "picnic.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.3.reply.2",
            "image": "picnic.banana.image",
            "text": "A banana, please.",
            "cn": "请给我一根香蕉。",
            "audio": "picnic.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.3.reply.2.follow",
                "text": "Here is your banana.",
                "audio": "picnic.dialogue.3.reply.2.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.3.reply.3",
            "image": "picnic.wave",
            "text": "No food yet, thank you.",
            "cn": "我还不想吃，谢谢。",
            "audio": "picnic.dialogue.3.reply.3.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.3.reply.3.follow",
                "text": "That is okay. We can enjoy the sunshine.",
                "audio": "picnic.dialogue.3.reply.3.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "picnic.dialogue.4",
        "cn": "我们也分享一点面包好吗？",
        "question": [
          {
            "id": "picnic.dialogue.4.question",
            "text": "Shall we share some bread, too?",
            "audio": "picnic.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.4.reply.1",
            "image": "picnic.bread.image",
            "text": "Yes! Let us share.",
            "cn": "好呀，一起分享。",
            "audio": "picnic.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.4.reply.1.follow",
                "text": "Here is some bread for each of us.",
                "audio": "picnic.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.4.reply.2",
            "image": "picnic.wave",
            "text": "No, thank you.",
            "cn": "不用了，谢谢。",
            "audio": "picnic.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.4.reply.2.follow",
                "text": "That is okay. I will keep it here.",
                "audio": "picnic.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "picnic.dialogue.5",
        "cn": "我们带了牛奶。你想喝点东西吗？",
        "question": [
          {
            "id": "picnic.dialogue.5.question",
            "text": "We have milk. Would you like a drink?",
            "audio": "picnic.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.5.reply.1",
            "image": "picnic.milk.image",
            "text": "Some milk, please.",
            "cn": "请给我一些牛奶。",
            "audio": "picnic.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.5.reply.1.follow",
                "text": "Here is your milk. Take a little sip.",
                "audio": "picnic.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.5.reply.2",
            "image": "picnic.wave",
            "text": "Not now, thank you.",
            "cn": "现在不想喝，谢谢。",
            "audio": "picnic.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.5.reply.2.follow",
                "text": "All right. You can have a drink later.",
                "audio": "picnic.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "picnic.dialogue.6",
        "cn": "野餐后我们做什么呢？",
        "question": [
          {
            "id": "picnic.dialogue.6.question",
            "text": "What shall we do after our picnic?",
            "audio": "picnic.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.6.reply.1",
            "image": "picnic.bunny",
            "text": "Let us play together.",
            "cn": "我们一起玩吧。",
            "audio": "picnic.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.6.reply.1.follow",
                "text": "Good idea! We can play after tidying up.",
                "audio": "picnic.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.6.reply.2",
            "image": "picnic.momo",
            "text": "Let us tell a story.",
            "cn": "我们讲个故事吧。",
            "audio": "picnic.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.6.reply.2.follow",
                "text": "Lovely! I have a story to share.",
                "audio": "picnic.dialogue.6.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "picnic.dialogue.7",
        "cn": "玩之前，我们把野餐的东西整理好吗？",
        "question": [
          {
            "id": "picnic.dialogue.7.question",
            "text": "Before we play, shall we tidy our picnic?",
            "audio": "picnic.dialogue.7.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.7.reply.1",
            "image": "picnic.basket",
            "text": "I can carry the basket.",
            "cn": "我可以提篮子。",
            "audio": "picnic.dialogue.7.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.7.reply.1.follow",
                "text": "Thank you! I will put our food away.",
                "audio": "picnic.dialogue.7.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.7.reply.2",
            "image": "picnic.bunny",
            "text": "Let us do it together.",
            "cn": "我们一起整理吧。",
            "audio": "picnic.dialogue.7.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.7.reply.2.follow",
                "text": "Together we can make this spot clean.",
                "audio": "picnic.dialogue.7.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "picnic.dialogue.8",
        "cn": "谢谢你一起野餐。你玩得开心吗？",
        "question": [
          {
            "id": "picnic.dialogue.8.question",
            "text": "Thank you for our picnic. Did you enjoy it?",
            "audio": "picnic.dialogue.8.question.audio"
          }
        ],
        "options": [
          {
            "id": "picnic.dialogue.8.reply.1",
            "image": "picnic.momo",
            "text": "Yes! Let us picnic again.",
            "cn": "开心！下次再一起野餐。",
            "audio": "picnic.dialogue.8.reply.1.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.8.reply.1.follow",
                "text": "I would love that. See you next time!",
                "audio": "picnic.dialogue.8.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "picnic.dialogue.8.reply.2",
            "image": "picnic.wave",
            "text": "Thank you for sharing with me.",
            "cn": "谢谢你和我分享。",
            "audio": "picnic.dialogue.8.reply.2.audio",
            "followUp": [
              {
                "id": "picnic.dialogue.8.reply.2.follow",
                "text": "You are welcome. It is lovely sharing with you.",
                "audio": "picnic.dialogue.8.reply.2.follow.audio"
              }
            ]
          }
        ]
      }
    ],
