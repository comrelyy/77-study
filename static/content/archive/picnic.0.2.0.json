        "translation": "和 Momo 一起分享牛奶。",
        "segments": [
          {
            "id": "picnic.story.4.intro",
            "text": "Hello! Let us have a picnic.",
            "audio": "picnic.story.4.intro.audio"
          },
          {
            "id": "picnic.story.4.item",
