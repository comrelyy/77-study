      "id": "picnic.dialogue.1.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.1.question.audio.wav",
      "text": "Hello, Bunny! Shall we have a picnic?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.1.reply.1.audio.wav",
      "text": "Yes! Let us have a picnic.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.1.reply.1.follow.audio.wav",
      "text": "Great! I brought our basket.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.1.reply.2.audio.wav",
      "text": "Can I join you?",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.1.reply.2.follow.audio.wav",
      "text": "Of course! There is room for you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.2.question.audio.wav",
      "text": "Where shall we sit?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.2.reply.1.audio.wav",
      "text": "Let us sit here.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.2.reply.1.follow.audio.wav",
      "text": "Here is a lovely spot for our picnic.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.2.reply.2.audio.wav",
      "text": "Next to you, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.2.reply.2.follow.audio.wav",
      "text": "Come and sit beside me.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.3.question.audio.wav",
      "text": "What would you like from our basket?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.3.reply.1.audio.wav",
      "text": "An apple, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.3.reply.1.follow.audio.wav",
      "text": "Here is your apple.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.3.reply.2.audio.wav",
      "text": "A banana, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.3.reply.2.follow.audio.wav",
      "text": "Here is your banana.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.3.reply.3.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.3.reply.3.audio.wav",
      "text": "No food yet, thank you.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.3.reply.3.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.3.reply.3.follow.audio.wav",
      "text": "That is okay. We can enjoy the sunshine.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.4.question.audio.wav",
      "text": "Shall we share some bread, too?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.4.reply.1.audio.wav",
      "text": "Yes! Let us share.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.4.reply.1.follow.audio.wav",
      "text": "Here is some bread for each of us.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.4.reply.2.audio.wav",
      "text": "No, thank you.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.4.reply.2.follow.audio.wav",
      "text": "That is okay. I will keep it here.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.5.question.audio.wav",
      "text": "We have milk. Would you like a drink?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.5.reply.1.audio.wav",
      "text": "Some milk, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.5.reply.1.follow.audio.wav",
      "text": "Here is your milk. Take a little sip.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.5.reply.2.audio.wav",
      "text": "Not now, thank you.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.5.reply.2.follow.audio.wav",
      "text": "All right. You can have a drink later.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.6.question.audio.wav",
      "text": "What shall we do after our picnic?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.6.reply.1.audio.wav",
      "text": "Let us play together.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.6.reply.1.follow.audio.wav",
      "text": "Good idea! We can play after tidying up.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.6.reply.2.audio.wav",
      "text": "Let us tell a story.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.6.reply.2.follow.audio.wav",
      "text": "Lovely! I have a story to share.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.7.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.7.question.audio.wav",
      "text": "Before we play, shall we tidy our picnic?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.7.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.7.reply.1.audio.wav",
      "text": "I can carry the basket.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.7.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.7.reply.1.follow.audio.wav",
      "text": "Thank you! I will put our food away.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.7.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.7.reply.2.audio.wav",
      "text": "Let us do it together.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.7.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.7.reply.2.follow.audio.wav",
      "text": "Together we can make this spot clean.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.8.question.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.8.question.audio.wav",
      "text": "Thank you for our picnic. Did you enjoy it?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.8.reply.1.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.8.reply.1.audio.wav",
      "text": "Yes! Let us picnic again.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.8.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.8.reply.1.follow.audio.wav",
      "text": "I would love that. See you next time!",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.8.reply.2.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.8.reply.2.audio.wav",
      "text": "Thank you for sharing with me.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "picnic.dialogue.8.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/picnic/v02/picnic.dialogue.8.reply.2.follow.audio.wav",
      "text": "You are welcome. It is lovely sharing with you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    }
