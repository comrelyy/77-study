    {
      "id": "washing.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.2.reply.2.follow.audio.wav",
      "text": "Watch my hands. We can rub them together.",
