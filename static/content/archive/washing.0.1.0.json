    },
    {
      "id": "washing.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.3.reply.2.follow.audio.wav",
      "text": "Stop and ask our grown-up for help.",
