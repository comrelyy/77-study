  "modules": {
    "story": [
      {
        "id": "birthday.story.1",
        "title": "1. 生日帽",
        "templateId": "daily-life",
        "illustration": "birthday.story.1.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.hat.clothing",
        "hotspots": [
          {
            "word": "en.hat.clothing",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "到了生日会，Momo 戴上了一顶黄色的帽子。",
        "segments": [
          {
            "id": "birthday.story.1.intro",
            "text": "Momo and Lulu come to the birthday party.",
            "cn": "Momo 和 Lulu 来参加生日会。",
            "speaker": "narrator",
            "audio": "birthday.story.1.intro.audio"
          },
          {
            "id": "birthday.story.1.item",
            "text": "Look at my new hat!",
            "cn": "看我的新帽子！",
            "speaker": "momo",
            "audio": "birthday.story.1.item.audio"
          },
          {
            "id": "birthday.story.1.reply",
            "text": "It is a yellow hat. I like it.",
            "cn": "是一顶黄帽子。我很喜欢。",
            "speaker": "bunny",
            "audio": "birthday.story.1.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.2",
        "title": "2. 一杯果汁",
        "templateId": "daily-life",
        "illustration": "birthday.story.2.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.cup.container",
        "hotspots": [
          {
            "word": "en.cup.container",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "Lulu 给大家倒了一杯果汁。",
        "segments": [
          {
            "id": "birthday.story.2.intro",
            "text": "Lulu pours juice into a cup.",
            "cn": "Lulu 把果汁倒进杯子里。",
            "speaker": "narrator",
            "audio": "birthday.story.2.intro.audio"
          },
          {
            "id": "birthday.story.2.item",
            "text": "Can I hold the cup?",
            "cn": "我可以拿着杯子吗？",
            "speaker": "momo",
            "audio": "birthday.story.2.item.audio"
          },
          {
            "id": "birthday.story.2.reply",
            "text": "Yes, you can. Be gentle with it.",
            "cn": "可以呀。要轻轻地拿。",
            "speaker": "bunny",
            "audio": "birthday.story.2.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.3",
        "title": "3. 圆圆的球",
        "templateId": "daily-life",
        "illustration": "birthday.story.3.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.ball.toy",
        "hotspots": [
          {
            "word": "en.ball.toy",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "他们在草地上玩球。",
        "segments": [
          {
            "id": "birthday.story.3.intro",
            "text": "The friends play on the grass.",
            "cn": "朋友们在草地上玩。",
            "speaker": "narrator",
            "audio": "birthday.story.3.intro.audio"
          },
          {
            "id": "birthday.story.3.item",
            "text": "I kick the ball to you.",
            "cn": "我把球踢给你。",
            "speaker": "momo",
            "audio": "birthday.story.3.item.audio"
          },
          {
            "id": "birthday.story.3.reply",
            "text": "I catch the ball. Hooray!",
            "cn": "我接住球啦。好耶！",
            "speaker": "bunny",
            "audio": "birthday.story.3.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.4",
        "title": "4. 泰迪熊",
        "templateId": "daily-life",
        "illustration": "birthday.story.4.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.teddy.toy",
        "hotspots": [
          {
            "word": "en.teddy.toy",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "Momo 找到了一只泰迪熊，要轻轻抱它。",
        "segments": [
          {
            "id": "birthday.story.4.intro",
            "text": "A teddy sits under the table.",
            "cn": "桌子下面坐着一只小熊。",
            "speaker": "narrator",
            "audio": "birthday.story.4.intro.audio"
          },
          {
            "id": "birthday.story.4.item",
            "text": "Look, a little teddy!",
            "cn": "看，一只小小熊！",
            "speaker": "momo",
            "audio": "birthday.story.4.item.audio"
          },
          {
            "id": "birthday.story.4.reply",
            "text": "Hug the teddy gently.",
            "cn": "轻轻地抱抱小熊。",
            "speaker": "bunny",
            "audio": "birthday.story.4.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.5",
        "title": "5. 唱生日歌",
        "templateId": "daily-life",
        "illustration": "birthday.story.5.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.hat.clothing",
        "hotspots": [
          {
            "word": "en.hat.clothing",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "大家围在一起唱生日歌。",
        "segments": [
          {
            "id": "birthday.story.5.intro",
            "text": "Everyone sings a happy song.",
            "cn": "大家一起唱一首快乐的歌。",
            "speaker": "narrator",
            "audio": "birthday.story.5.intro.audio"
          },
          {
            "id": "birthday.story.5.item",
            "text": "Happy birthday! You are four now.",
            "cn": "生日快乐！你现在四岁啦。",
            "speaker": "bunny",
            "audio": "birthday.story.5.item.audio"
          },
          {
            "id": "birthday.story.5.reply",
            "text": "I wear my hat. I am four years old.",
            "cn": "我戴着帽子。我四岁了。",
            "speaker": "momo",
            "audio": "birthday.story.5.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.6",
        "title": "6. 美好的一天",
        "templateId": "daily-life",
        "illustration": "birthday.story.6.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.ball.toy",
        "hotspots": [
          {
            "word": "en.ball.toy",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "派对结束了，大家都很开心。",
        "segments": [
          {
            "id": "birthday.story.6.intro",
            "text": "The party is over and the sun goes down.",
            "cn": "派对结束了，太阳下山了。",
            "speaker": "narrator",
            "audio": "birthday.story.6.intro.audio"
          },
          {
            "id": "birthday.story.6.item",
            "text": "Thank you for the nice day.",
            "cn": "谢谢你陪我度过美好的一天。",
            "speaker": "momo",
            "audio": "birthday.story.6.item.audio"
          },
          {
            "id": "birthday.story.6.reply",
            "text": "Keep your ball, my good friend.",
            "cn": "球你留着吧，我的好朋友。",
            "speaker": "bunny",
            "audio": "birthday.story.6.reply.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "birthday.dialogue.1",
        "cn": "你想戴什么？",
        "question": [
          {
            "id": "birthday.dialogue.1.question",
            "text": "What do you want to wear?",
            "audio": "birthday.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.1.reply.1",
            "text": "I want to wear the hat.",
            "cn": "我想戴这顶帽子。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.1.reply.1.follow",
                "text": "The hat looks great on you!",
                "audio": "birthday.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.1.reply.2",
            "text": "The hat, please.",
            "cn": "请给我帽子。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.1.reply.2.follow",
                "text": "Yes, put it on your head.",
                "audio": "birthday.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.2",
        "cn": "杯子里有什么？",
        "question": [
          {
            "id": "birthday.dialogue.2.question",
            "text": "What is in the cup?",
            "audio": "birthday.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.2.reply.1",
            "text": "There is juice.",
            "cn": "有果汁。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.2.reply.1.follow",
                "text": "Yummy! Drink it slowly.",
                "audio": "birthday.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.2.reply.2",
            "text": "I see juice in the cup.",
            "cn": "我看见杯子里有果汁。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.2.reply.2.follow",
                "text": "Hold the cup with two hands.",
                "audio": "birthday.dialogue.2.reply.2.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.2.reply.3",
            "text": "There is milk.",
            "cn": "有牛奶。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.2.reply.3.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.2.reply.3.follow",
                "text": "Milk is good for you.",
                "audio": "birthday.dialogue.2.reply.3.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.3",
        "cn": "我们玩什么好呢？",
        "question": [
          {
            "id": "birthday.dialogue.3.question",
            "text": "What shall we play?",
            "audio": "birthday.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.3.reply.1",
            "text": "We can play with the ball.",
            "cn": "我们玩球吧。",
            "image": "birthday.ball.image",
            "audio": "birthday.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.3.reply.1.follow",
                "text": "Great! I will catch it.",
                "audio": "birthday.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.3.reply.2",
            "text": "We can roll the ball.",
            "cn": "我们可以滚球。",
            "image": "birthday.ball.image",
            "audio": "birthday.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.3.reply.2.follow",
                "text": "Here it comes. Roll, roll, roll!",
                "audio": "birthday.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.4",
        "cn": "你想抱谁？",
        "question": [
          {
            "id": "birthday.dialogue.4.question",
            "text": "Who do you want to hug?",
            "audio": "birthday.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.4.reply.1",
            "text": "I hug the teddy.",
            "cn": "我抱泰迪熊。",
            "image": "birthday.teddy.image",
            "audio": "birthday.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.4.reply.1.follow",
                "text": "The teddy likes a gentle hug.",
                "audio": "birthday.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.4.reply.2",
            "text": "I want the teddy.",
            "cn": "我想抱泰迪熊。",
            "image": "birthday.teddy.image",
            "audio": "birthday.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.4.reply.2.follow",
                "text": "Here you are. Hug it softly.",
                "audio": "birthday.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.5",
        "cn": "你的帽子是什么颜色？",
        "question": [
          {
            "id": "birthday.dialogue.5.question",
            "text": "What color is your hat?",
            "audio": "birthday.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.5.reply.1",
            "text": "My hat is yellow.",
            "cn": "我的帽子是黄色的。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.5.reply.1.follow",
                "text": "Yellow is a lovely color.",
                "audio": "birthday.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.5.reply.2",
            "text": "It is green and yellow.",
            "cn": "是绿色和黄色的。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.5.reply.2.follow",
                "text": "Green and yellow look nice.",
                "audio": "birthday.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.6",
        "cn": "今天你最喜欢什么？",
        "question": [
          {
            "id": "birthday.dialogue.6.question",
            "text": "What do you like best today?",
            "audio": "birthday.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.6.reply.1",
            "text": "I like the ball.",
            "cn": "我最喜欢球。",
            "image": "birthday.ball.image",
            "audio": "birthday.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.6.reply.1.follow",
                "text": "Me too! It is round and fun.",
                "audio": "birthday.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.6.reply.2",
            "text": "I like the cup.",
            "cn": "我最喜欢杯子。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.6.reply.2.follow",
                "text": "Nice cup! Drink your juice.",
                "audio": "birthday.dialogue.6.reply.2.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.6.reply.3",
            "text": "I like the teddy.",
            "cn": "我最喜欢泰迪熊。",
            "image": "birthday.teddy.image",
            "audio": "birthday.dialogue.6.reply.3.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.6.reply.3.follow",
                "text": "The teddy is a good friend.",
                "audio": "birthday.dialogue.6.reply.3.follow.audio"
              }
            ]
          }
        ]
      }
    ],
