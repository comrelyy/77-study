            "id": "tidy.dialogue.4.reply.1",
            "image": "tidy.teddy.image",
            "text": "On the shelf, please.",
            "cn": "请放在架子上。",
            "audio": "tidy.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.4.reply.1.follow",
                "text": "The shelf is a cosy home for teddy.",
                "audio": "tidy.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "tidy.dialogue.4.reply.2",
            "image": "tidy.momo",
            "text": "Please help me reach the shelf.",
            "cn": "请帮我够到架子。",
            "audio": "tidy.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.4.reply.2.follow",
                "text": "I can help. Let us put teddy there together.",
                "audio": "tidy.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "tidy.dialogue.5",
        "cn": "地板已经整洁了，我们接下来做什么呢？",
        "question": [
          {
            "id": "tidy.dialogue.5.question",
            "text": "The floor is clear now. What shall we do?",
            "audio": "tidy.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "tidy.dialogue.5.reply.1",
            "image": "tidy.car.image",
            "text": "Let us play with the car.",
            "cn": "我们玩小汽车吧。",
            "audio": "tidy.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.5.reply.1.follow",
                "text": "Yes! We can put it back after playing.",
                "audio": "tidy.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "tidy.dialogue.5.reply.2",
            "image": "tidy.ball.image",
            "text": "Let us play with the ball.",
            "cn": "我们玩球吧。",
            "audio": "tidy.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.5.reply.2.follow",
                "text": "Yes! We have a clear space to play.",
                "audio": "tidy.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "tidy.dialogue.6",
        "cn": "谢谢你帮忙，下次我们还一起整理好吗？",
        "question": [
          {
            "id": "tidy.dialogue.6.question",
            "text": "Thank you for helping. Shall we tidy again next time?",
            "audio": "tidy.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "tidy.dialogue.6.reply.1",
            "image": "tidy.momo",
            "text": "Yes! We are a good team.",
            "cn": "好呀，我们是好搭档。",
            "audio": "tidy.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.6.reply.1.follow",
                "text": "We are! Thank you for helping our toys find homes.",
                "audio": "tidy.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "tidy.dialogue.6.reply.2",
            "image": "tidy.wave",
            "text": "See you next time!",
            "cn": "下次见！",
            "audio": "tidy.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.6.reply.2.follow",
                "text": "See you! Our toys will be waiting.",
                "audio": "tidy.dialogue.6.reply.2.follow.audio"
              }
            ]
          }
        ]
      }
