    "dialogue": [
      {
        "id": "tidy.dialogue.1",
        "cn": "玩具散落一地，我们一起整理好吗？",
        "question": [
          {
            "id": "tidy.dialogue.1.question",
            "text": "Our toys are everywhere. Shall we tidy up?",
            "audio": "tidy.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "tidy.dialogue.1.reply.1",
            "image": "tidy.ball.image",
            "text": "Yes! Let us do it together.",
            "cn": "好呀，我们一起整理。",
            "audio": "tidy.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.1.reply.1.follow",
                "text": "Great! Let us choose a toy first.",
                "audio": "tidy.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "tidy.dialogue.1.reply.2",
            "image": "tidy.wave",
            "text": "Please help me.",
            "cn": "请帮帮我。",
            "audio": "tidy.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.1.reply.2.follow",
                "text": "Of course. We can start together.",
                "audio": "tidy.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "tidy.dialogue.2",
        "cn": "我们先拿起哪件玩具？",
        "question": [
          {
            "id": "tidy.dialogue.2.question",
            "text": "Which toy shall we pick up first?",
            "audio": "tidy.dialogue.2.question.audio"
