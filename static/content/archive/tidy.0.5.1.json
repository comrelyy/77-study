        ],
        "options": [
          {
            "id": "tidy.dialogue.2.reply.1",
            "image": "tidy.ball.image",
            "text": "The ball, please.",
            "cn": "先拿球吧。",
            "audio": "tidy.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.2.reply.1.follow",
                "text": "Let us pick up the ball carefully.",
                "audio": "tidy.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "tidy.dialogue.2.reply.2",
            "image": "tidy.car.image",
            "text": "The car, please.",
            "cn": "先拿小汽车吧。",
            "audio": "tidy.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.2.reply.2.follow",
                "text": "Let us pick up the little car.",
                "audio": "tidy.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "tidy.dialogue.3",
        "cn": "小玩具可以放在哪里？",
        "question": [
          {
            "id": "tidy.dialogue.3.question",
            "text": "Where can we put our small toys?",
            "audio": "tidy.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "tidy.dialogue.3.reply.1",
            "image": "tidy.ball.image",
            "text": "In the toy box.",
            "cn": "放在玩具箱里。",
            "audio": "tidy.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.3.reply.1.follow",
                "text": "Yes! The toy box has room for them.",
                "audio": "tidy.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "tidy.dialogue.3.reply.2",
            "image": "tidy.momo",
            "text": "Can you show me?",
            "cn": "你能示范一下吗？",
            "audio": "tidy.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "tidy.dialogue.3.reply.2.follow",
                "text": "Here is the toy box. Put small toys inside.",
                "audio": "tidy.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "tidy.dialogue.4",
        "cn": "小熊玩偶也需要一个家，放在哪里呢？",
        "question": [
          {
            "id": "tidy.dialogue.4.question",
            "text": "Our teddy needs a home, too. Where shall it go?",
            "audio": "tidy.dialogue.4.question.audio"
          }
        ],
        "options": [
