    {
      "id": "tidy.dialogue.1.question.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.1.question.audio.wav",
      "text": "Our toys are everywhere. Shall we tidy up?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.1.reply.1.audio.wav",
      "text": "Yes! Let us do it together.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.1.reply.1.follow.audio.wav",
      "text": "Great! Let us choose a toy first.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.1.reply.2.audio.wav",
      "text": "Please help me.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.1.reply.2.follow.audio.wav",
      "text": "Of course. We can start together.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.2.question.audio.wav",
      "text": "Which toy shall we pick up first?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.2.reply.1.audio.wav",
      "text": "The ball, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.2.reply.1.follow.audio.wav",
      "text": "Let us pick up the ball carefully.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.2.reply.2.audio.wav",
      "text": "The car, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.2.reply.2.follow.audio.wav",
      "text": "Let us pick up the little car.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.3.question.audio.wav",
      "text": "Where can we put our small toys?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.3.reply.1.audio.wav",
      "text": "In the toy box.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.3.reply.1.follow.audio.wav",
      "text": "Yes! The toy box has room for them.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.3.reply.2.audio.wav",
      "text": "Can you show me?",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.3.reply.2.follow.audio.wav",
      "text": "Here is the toy box. Put small toys inside.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.4.question.audio.wav",
      "text": "Our teddy needs a home, too. Where shall it go?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.4.reply.1.audio.wav",
      "text": "On the shelf, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.4.reply.1.follow.audio.wav",
      "text": "The shelf is a cosy home for teddy.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.4.reply.2.audio.wav",
      "text": "Please help me reach the shelf.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.4.reply.2.follow.audio.wav",
      "text": "I can help. Let us put teddy there together.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.5.question.audio.wav",
      "text": "The floor is clear now. What shall we do?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.5.reply.1.audio.wav",
      "text": "Let us play with the car.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.5.reply.1.follow.audio.wav",
      "text": "Yes! We can put it back after playing.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.5.reply.2.audio.wav",
      "text": "Let us play with the ball.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.5.reply.2.follow.audio.wav",
      "text": "Yes! We have a clear space to play.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.6.question.audio.wav",
      "text": "Thank you for helping. Shall we tidy again next time?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.6.reply.1.audio.wav",
      "text": "Yes! We are a good team.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.6.reply.1.follow.audio.wav",
      "text": "We are! Thank you for helping our toys find homes.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.6.reply.2.audio.wav",
      "text": "See you next time!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "tidy.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/tidy/v02/tidy.dialogue.6.reply.2.follow.audio.wav",
      "text": "See you! Our toys will be waiting.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
