    "dialogue": [
      {
        "id": "bedtime.dialogue.1",
        "cn": "今晚我们读哪本书呢？",
        "question": [
          {
            "id": "bedtime.dialogue.1.question",
            "text": "Which book shall we read tonight?",
            "audio": "bedtime.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.1.reply.1",
            "text": "This book, please.",
            "cn": "请读这一本。",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.1.reply.1.follow",
                "text": "Let us sit together and open it.",
                "audio": "bedtime.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.1.reply.2",
            "text": "Please help me choose.",
            "cn": "请帮我选一本。",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.1.reply.2.follow",
                "text": "We can look at the covers together.",
                "audio": "bedtime.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.2",
        "cn": "我们的小熊玩偶在哪里？",
        "question": [
          {
            "id": "bedtime.dialogue.2.question",
            "text": "Where is our teddy?",
            "audio": "bedtime.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.2.reply.1",
            "text": "Behind the cushion!",
            "cn": "在靠垫后面！",
            "image": "bedtime.teddy.image",
            "audio": "bedtime.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.2.reply.1.follow",
                "text": "You found teddy. Let us give it a cuddle.",
                "audio": "bedtime.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.2.reply.2",
            "text": "Please look with me.",
            "cn": "请陪我一起找。",
            "image": "bedtime.teddy.image",
            "audio": "bedtime.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.2.reply.2.follow",
                "text": "I will look beside the bed with you.",
                "audio": "bedtime.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.3",
        "cn": "你的床舒服吗？",
        "question": [
          {
            "id": "bedtime.dialogue.3.question",
            "text": "Is your bed comfortable?",
            "audio": "bedtime.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.3.reply.1",
            "text": "Yes, teddy is here too.",
            "cn": "舒服，小熊也在这里。",
            "image": "bedtime.bed.image",
            "audio": "bedtime.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.3.reply.1.follow",
                "text": "There is a cosy place for both of you.",
                "audio": "bedtime.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.3.reply.2",
            "text": "Help me with the blanket.",
            "cn": "帮我弄弄被子。",
            "image": "bedtime.bed.image",
            "audio": "bedtime.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.3.reply.2.follow",
                "text": "Let us ask our grown-up to help.",
                "audio": "bedtime.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.4",
        "cn": "你想让灯光暗一点吗？",
        "question": [
          {
            "id": "bedtime.dialogue.4.question",
            "text": "Would you like the lamp a little dimmer?",
            "audio": "bedtime.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.4.reply.1",
            "text": "A little dimmer, please.",
            "cn": "请调暗一点。",
            "image": "bedtime.lamp.image",
            "audio": "bedtime.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.4.reply.1.follow",
                "text": "Our grown-up can adjust the lamp.",
                "audio": "bedtime.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.4.reply.2",
            "text": "Please leave it on.",
            "cn": "请先让它亮着。",
            "image": "bedtime.lamp.image",
            "audio": "bedtime.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.4.reply.2.follow",
                "text": "Tell our grown-up what feels comfortable.",
                "audio": "bedtime.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.5",
        "cn": "我们现在把书合上好吗？",
        "question": [
          {
            "id": "bedtime.dialogue.5.question",
            "text": "Shall we close our book now?",
            "audio": "bedtime.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.5.reply.1",
            "text": "One more page, please.",
            "cn": "请再读一页。",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.5.reply.1.follow",
                "text": "We can ask our grown-up to read one more.",
                "audio": "bedtime.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.5.reply.2",
            "text": "Yes. Goodnight, book!",
            "cn": "好，书本晚安！",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.5.reply.2.follow",
                "text": "We can put it back on the shelf.",
                "audio": "bedtime.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.6",
        "cn": "你想有人在旁边陪着吗？",
        "question": [
          {
            "id": "bedtime.dialogue.6.question",
            "text": "Would you like someone to stay nearby?",
            "audio": "bedtime.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.6.reply.1",
            "text": "Stay with me, please.",
            "cn": "请陪着我。",
            "image": "bedtime.bed.image",
            "audio": "bedtime.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.6.reply.1.follow",
                "text": "Let us ask our grown-up to stay close.",
                "audio": "bedtime.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.6.reply.2",
            "text": "Goodnight. I am ready to rest.",
            "cn": "晚安，我准备休息了。",
            "image": "bedtime.teddy.image",
            "audio": "bedtime.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.6.reply.2.follow",
                "text": "Goodnight. Take your time and get comfortable.",
                "audio": "bedtime.dialogue.6.reply.2.follow.audio"
              }
            ]
          }
        ]
      }
