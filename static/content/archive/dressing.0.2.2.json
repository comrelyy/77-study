    {
      "id": "dressing.dialogue.1.question.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.1.question.audio.wav",
      "text": "Shall we get ready for our walk?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.1.reply.1.audio.wav",
      "text": "Yes! I need my shirt.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.1.reply.1.follow.audio.wav",
      "text": "Here is your shirt. Let us get dressed.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.1.reply.2.audio.wav",
      "text": "Help me, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.1.reply.2.follow.audio.wav",
      "text": "Of course. We can get ready together.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.2.question.audio.wav",
      "text": "Where is the other sock?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.2.reply.1.audio.wav",
      "text": "Under the chair!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.2.reply.1.follow.audio.wav",
      "text": "You found it. Now we have two socks.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.2.reply.2.audio.wav",
      "text": "Let us look together.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.2.reply.2.follow.audio.wav",
      "text": "I will look beside the chair.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.3.question.audio.wav",
      "text": "Are your shoes comfortable?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.3.reply.1.audio.wav",
      "text": "These feel funny.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.3.reply.1.follow.audio.wav",
      "text": "Let us check which shoe goes on each foot.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.3.reply.2.audio.wav",
      "text": "Help me swap them, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.3.reply.2.follow.audio.wav",
      "text": "I can help. We can try again.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.4.question.audio.wav",
      "text": "Would you like your hat?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.4.reply.1.audio.wav",
      "text": "Yes, my hat, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.4.reply.1.follow.audio.wav",
      "text": "Here it is. Shall I help you?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.4.reply.2.audio.wav",
      "text": "I can put it on.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.4.reply.2.follow.audio.wav",
      "text": "Go ahead. I am here if you need help.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.5.question.audio.wav",
      "text": "Shall we check before we go?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.5.reply.1.audio.wav",
      "text": "Shirt, socks, shoes, and hat!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.5.reply.1.follow.audio.wav",
      "text": "Everything is ready for our walk.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.5.reply.2.audio.wav",
      "text": "My shoes need help.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.5.reply.2.follow.audio.wav",
      "text": "We can stop and fix them first.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.6.question.audio.wav",
      "text": "Are you ready to open the door?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.6.reply.1.audio.wav",
      "text": "Yes! Let us go together.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.6.reply.1.follow.audio.wav",
      "text": "Let us ask our grown-up to come too.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.6.reply.2.audio.wav",
      "text": "Please wait for me.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "dressing.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/dressing/v0-1-0/dressing.dialogue.6.reply.2.follow.audio.wav",
