  "modules": {
    "story": [
      {
        "id": "bedtime.story.1",
        "title": "1. 两个人想读不同的书",
        "templateId": "daily-life",
        "illustration": "bedtime.story.1.image",
        "characters": [
          "bedtime.momo",
          "bedtime.bunny"
        ],
        "mainWord": "en.book.object",
        "hotspots": [
          {
            "word": "en.book.object",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "天慢慢黑了。两人想读不同的书，于是坐下来一起商量。",
        "segments": [
          {
            "id": "bedtime.story.1.intro",
            "text": "The sky is getting dark.",
            "cn": "天慢慢黑了。",
            "speaker": "narrator",
            "audio": "bedtime.story.1.intro.audio"
          },
          {
            "id": "bedtime.story.1.item",
            "text": "I want this book.",
            "cn": "我想看这本书。",
            "speaker": "momo",
            "audio": "bedtime.story.1.item.audio"
          },
          {
            "id": "bedtime.story.1.reply",
            "text": "I want that one. Can we choose together?",
            "cn": "我想看那本。我们一起选好吗？",
            "speaker": "bunny",
            "audio": "bedtime.story.1.reply.audio"
          },
          {
            "id": "bedtime.story.1.more1",
            "text": "Okay. Let us look at both.",
            "cn": "好呀。我们两本都看看。",
            "speaker": "momo",
            "audio": "bedtime.story.1.more1.audio"
          }
        ]
      },
      {
        "id": "bedtime.story.2",
        "title": "2. 你一页，我一页",
        "templateId": "daily-life",
        "illustration": "bedtime.story.2.image",
        "characters": [
          "bedtime.bunny",
          "bedtime.momo"
        ],
        "mainWord": "en.book.object",
        "hotspots": [
          {
            "word": "en.book.object",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "他们选好一本书，决定你翻一页、我翻一页，一起看故事。",
        "segments": [
          {
            "id": "bedtime.story.2.intro",
            "text": "The friends choose a book together.",
            "cn": "朋友们一起选好了一本书。",
            "speaker": "narrator",
            "audio": "bedtime.story.2.intro.audio"
          },
          {
            "id": "bedtime.story.2.item",
            "text": "You turn this page. I will turn the next.",
            "cn": "你翻这一页，我翻下一页。",
            "speaker": "bunny",
            "audio": "bedtime.story.2.item.audio"
          },
          {
            "id": "bedtime.story.2.reply",
            "text": "Good idea. Let us take turns.",
            "cn": "好主意。我们轮流翻。",
            "speaker": "momo",
            "audio": "bedtime.story.2.reply.audio"
          },
          {
            "id": "bedtime.story.2.more1",
            "text": "Now it is your turn.",
            "cn": "现在轮到你了。",
            "speaker": "bunny",
            "audio": "bedtime.story.2.more1.audio"
          }
        ]
      },
      {
        "id": "bedtime.story.3",
        "title": "3. 小熊玩偶不见了",
        "templateId": "daily-life",
        "illustration": "bedtime.story.3.image",
        "characters": [
          "bedtime.momo",
          "bedtime.bunny"
        ],
        "mainWord": "en.teddy.toy",
        "hotspots": [
          {
            "word": "en.teddy.toy",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 找不到小熊玩偶。Lulu 陪着一起找，在靠垫后面发现了它。",
        "segments": [
          {
            "id": "bedtime.story.3.intro",
            "text": "Teddy is not on the bed.",
            "cn": "小熊不在床上。",
            "speaker": "narrator",
            "audio": "bedtime.story.3.intro.audio"
          },
          {
            "id": "bedtime.story.3.item",
            "text": "I cannot find teddy.",
            "cn": "我找不到小熊了。",
            "speaker": "momo",
            "audio": "bedtime.story.3.item.audio"
          },
          {
            "id": "bedtime.story.3.reply",
            "text": "Look behind the cushion. I can help.",
            "cn": "看看靠垫后面。我来帮你。",
            "speaker": "bunny",
            "audio": "bedtime.story.3.reply.audio"
          },
          {
            "id": "bedtime.story.3.more1",
            "text": "I found teddy! Thank you, Lulu.",
            "cn": "我找到小熊了！谢谢你，Lulu。",
            "speaker": "momo",
            "audio": "bedtime.story.3.more1.audio"
          },
          {
            "id": "bedtime.story.3.more2",
            "text": "Now teddy can sleep too.",
            "cn": "现在小熊也可以睡觉了。",
            "speaker": "bunny",
            "audio": "bedtime.story.3.more2.audio"
          }
        ]
      },
      {
        "id": "bedtime.story.4",
        "title": "4. 舒服的小床",
        "templateId": "daily-life",
        "illustration": "bedtime.story.4.image",
        "characters": [
          "bedtime.momo",
          "bedtime.bunny"
        ],
        "mainWord": "en.bed.furniture",
        "hotspots": [
          {
            "word": "en.bed.furniture",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "床上的被子卷在一起，Momo 躺着不舒服。两人一起把被子铺平。",
        "segments": [
          {
            "id": "bedtime.story.4.intro",
            "text": "The blanket is twisted on the bed.",
            "cn": "床上的被子卷成了一团。",
            "speaker": "narrator",
            "audio": "bedtime.story.4.intro.audio"
          },
          {
            "id": "bedtime.story.4.item",
            "text": "My bed feels bumpy.",
            "cn": "我的床疙疙瘩瘩的。",
            "speaker": "momo",
            "audio": "bedtime.story.4.item.audio"
          },
          {
            "id": "bedtime.story.4.reply",
            "text": "Let us smooth the blanket together.",
            "cn": "我们一起把被子铺平吧。",
            "speaker": "bunny",
            "audio": "bedtime.story.4.reply.audio"
          },
          {
            "id": "bedtime.story.4.more1",
            "text": "Now it feels soft.",
            "cn": "现在软软的了。",
            "speaker": "momo",
            "audio": "bedtime.story.4.more1.audio"
          }
        ]
      },
      {
        "id": "bedtime.story.5",
        "title": "5. 灯光听你的",
        "templateId": "daily-life",
        "illustration": "bedtime.story.5.image",
        "characters": [
          "bedtime.bunny",
          "bedtime.momo"
        ],
        "mainWord": "en.lamp.object",
        "hotspots": [
          {
            "word": "en.lamp.object",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "灯还有点亮。Momo 想调暗一点，也表达暂时不想关掉。",
        "segments": [
          {
            "id": "bedtime.story.5.intro",
            "text": "The lamp is still bright.",
            "cn": "灯还很亮。",
            "speaker": "narrator",
            "audio": "bedtime.story.5.intro.audio"
          },
          {
            "id": "bedtime.story.5.item",
            "text": "Would you like it dimmer?",
            "cn": "你想把灯调暗一点吗？",
            "speaker": "bunny",
            "audio": "bedtime.story.5.item.audio"
          },
          {
            "id": "bedtime.story.5.reply",
            "text": "A little, please. Leave it on for now.",
            "cn": "暗一点点就好。先别关掉。",
            "speaker": "momo",
            "audio": "bedtime.story.5.reply.audio"
          },
          {
            "id": "bedtime.story.5.more1",
            "text": "Okay. A little dimmer.",
            "cn": "好的。暗一点点。",
            "speaker": "bunny",
            "audio": "bedtime.story.5.more1.audio"
          },
          {
            "id": "bedtime.story.5.more2",
            "text": "That is just right.",
            "cn": "这样刚刚好。",
            "speaker": "momo",
            "audio": "bedtime.story.5.more2.audio"
          }
        ]
      },
      {
        "id": "bedtime.story.6",
        "title": "6. 我想有人陪一会儿",
        "templateId": "daily-life",
        "illustration": "bedtime.story.6.image",
        "characters": [
          "bedtime.momo",
          "bedtime.bunny"
        ],
        "mainWord": "en.teddy.toy",
        "hotspots": [
          {
            "word": "en.teddy.toy",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "睡前都准备好了，Momo 还想有人陪一会儿。Lulu 帮忙请来大人，再轻轻道晚安。",
        "segments": [
          {
            "id": "bedtime.story.6.intro",
            "text": "Everything is ready for resting.",
            "cn": "睡觉前的事都准备好了。",
            "speaker": "narrator",
            "audio": "bedtime.story.6.intro.audio"
          },
          {
            "id": "bedtime.story.6.item",
            "text": "Please stay with me a little.",
            "cn": "请再陪我一会儿。",
            "speaker": "momo",
            "audio": "bedtime.story.6.item.audio"
          },
          {
            "id": "bedtime.story.6.reply",
            "text": "I will call our grown-up. Goodnight, friend.",
            "cn": "我去叫大人来。晚安，我的朋友。",
            "speaker": "bunny",
            "audio": "bedtime.story.6.reply.audio"
          },
          {
            "id": "bedtime.story.6.more1",
            "text": "Goodnight, Lulu.",
            "cn": "晚安，Lulu。",
            "speaker": "momo",
            "audio": "bedtime.story.6.more1.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "bedtime.dialogue.1",
        "cn": "今晚我们读哪本书呢？",
        "question": [
          {
            "id": "bedtime.dialogue.1.question",
            "text": "Which book shall we read tonight?",
            "audio": "bedtime.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.1.reply.1",
            "text": "This book, please.",
            "cn": "请读这一本。",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.1.reply.1.follow",
                "text": "Let us sit together and open it.",
                "audio": "bedtime.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.1.reply.2",
            "text": "Please help me choose.",
            "cn": "请帮我选一本。",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.1.reply.2.follow",
                "text": "We can look at the covers together.",
                "audio": "bedtime.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.2",
        "cn": "我们的小熊玩偶在哪里？",
        "question": [
          {
            "id": "bedtime.dialogue.2.question",
            "text": "Where is our teddy?",
            "audio": "bedtime.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.2.reply.1",
            "text": "Behind the cushion!",
            "cn": "在靠垫后面！",
            "image": "bedtime.teddy.image",
            "audio": "bedtime.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.2.reply.1.follow",
                "text": "You found teddy. Let us give it a cuddle.",
                "audio": "bedtime.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.2.reply.2",
            "text": "Please look with me.",
            "cn": "请陪我一起找。",
            "image": "bedtime.teddy.image",
            "audio": "bedtime.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.2.reply.2.follow",
                "text": "I will look beside the bed with you.",
                "audio": "bedtime.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.3",
        "cn": "你的床舒服吗？",
        "question": [
          {
            "id": "bedtime.dialogue.3.question",
            "text": "Is your bed comfortable?",
            "audio": "bedtime.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.3.reply.1",
            "text": "Yes, teddy is here too.",
            "cn": "舒服，小熊也在这里。",
            "image": "bedtime.bed.image",
            "audio": "bedtime.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.3.reply.1.follow",
                "text": "There is a cosy place for both of you.",
                "audio": "bedtime.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.3.reply.2",
            "text": "Help me with the blanket.",
            "cn": "帮我弄弄被子。",
            "image": "bedtime.bed.image",
            "audio": "bedtime.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.3.reply.2.follow",
                "text": "Let us ask our grown-up to help.",
                "audio": "bedtime.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.4",
        "cn": "你想让灯光暗一点吗？",
        "question": [
          {
            "id": "bedtime.dialogue.4.question",
            "text": "Would you like the lamp a little dimmer?",
            "audio": "bedtime.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.4.reply.1",
            "text": "A little dimmer, please.",
            "cn": "请调暗一点。",
            "image": "bedtime.lamp.image",
            "audio": "bedtime.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.4.reply.1.follow",
                "text": "Our grown-up can adjust the lamp.",
                "audio": "bedtime.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.4.reply.2",
            "text": "Please leave it on.",
            "cn": "请先让它亮着。",
            "image": "bedtime.lamp.image",
            "audio": "bedtime.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.4.reply.2.follow",
                "text": "Tell our grown-up what feels comfortable.",
                "audio": "bedtime.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.5",
        "cn": "我们现在把书合上好吗？",
        "question": [
          {
            "id": "bedtime.dialogue.5.question",
            "text": "Shall we close our book now?",
            "audio": "bedtime.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "bedtime.dialogue.5.reply.1",
            "text": "One more page, please.",
            "cn": "请再读一页。",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.5.reply.1.follow",
                "text": "We can ask our grown-up to read one more.",
                "audio": "bedtime.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "bedtime.dialogue.5.reply.2",
            "text": "Yes. Goodnight, book!",
            "cn": "好，书本晚安！",
            "image": "bedtime.book.image",
            "audio": "bedtime.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "bedtime.dialogue.5.reply.2.follow",
                "text": "We can put it back on the shelf.",
                "audio": "bedtime.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "bedtime.dialogue.6",
        "cn": "你想有人在旁边陪着吗？",
        "question": [
          {
