      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.1.reply.1.audio.wav",
      "text": "This book, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.1.reply.1.follow.audio.wav",
      "text": "Let us sit together and open it.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.1.reply.2.audio.wav",
      "text": "Please help me choose.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.1.reply.2.follow.audio.wav",
      "text": "We can look at the covers together.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.2.question.audio.wav",
      "text": "Where is our teddy?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.2.reply.1.audio.wav",
      "text": "Behind the cushion!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.2.reply.1.follow.audio.wav",
      "text": "You found teddy. Let us give it a cuddle.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.2.reply.2.audio.wav",
      "text": "Please look with me.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.2.reply.2.follow.audio.wav",
      "text": "I will look beside the bed with you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.3.question.audio.wav",
      "text": "Is your bed comfortable?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.3.reply.1.audio.wav",
      "text": "Yes, teddy is here too.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.3.reply.1.follow.audio.wav",
      "text": "There is a cosy place for both of you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.3.reply.2.audio.wav",
      "text": "Help me with the blanket.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.3.reply.2.follow.audio.wav",
      "text": "Let us ask our grown-up to help.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.4.question.audio.wav",
      "text": "Would you like the lamp a little dimmer?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.4.reply.1.audio.wav",
      "text": "A little dimmer, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.4.reply.1.follow.audio.wav",
      "text": "Our grown-up can adjust the lamp.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.4.reply.2.audio.wav",
      "text": "Please leave it on.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.4.reply.2.follow.audio.wav",
      "text": "Tell our grown-up what feels comfortable.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.5.question.audio.wav",
      "text": "Shall we close our book now?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.5.reply.1.audio.wav",
      "text": "One more page, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.5.reply.1.follow.audio.wav",
      "text": "We can ask our grown-up to read one more.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.5.reply.2.audio.wav",
      "text": "Yes. Goodnight, book!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.5.reply.2.follow.audio.wav",
      "text": "We can put it back on the shelf.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.6.question.audio.wav",
      "text": "Would you like someone to stay nearby?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.6.reply.1.audio.wav",
      "text": "Stay with me, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.6.reply.1.follow.audio.wav",
      "text": "Let us ask our grown-up to stay close.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.6.reply.2.audio.wav",
      "text": "Goodnight. I am ready to rest.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "bedtime.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/bedtime/v0-1-0/bedtime.dialogue.6.reply.2.follow.audio.wav",
