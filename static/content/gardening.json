        "id": "gardening.dialogue.6",
        "cn": "明天谁来看花盆呢？",
        "question": [
          {
            "id": "gardening.dialogue.6.question",
            "text": "Who will check the pot tomorrow?",
            "audio": "gardening.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "gardening.dialogue.6.reply.1",
            "text": "My turn tomorrow!",
            "cn": "明天轮到我！",
            "image": "gardening.pot.image",
            "audio": "gardening.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.6.reply.1.follow",
                "text": "I checked today. We can take turns.",
                "audio": "gardening.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "gardening.dialogue.6.reply.2",
            "text": "Let us make a plan.",
            "cn": "我们一起安排。",
            "image": "gardening.pot.image",
            "audio": "gardening.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.6.reply.2.follow",
                "text": "We can share the job.",
                "audio": "gardening.dialogue.6.reply.2.follow.audio"
              }
            ]
          }
        ]
      }
