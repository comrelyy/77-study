    "dialogue": [
      {
        "id": "gardening.dialogue.1",
        "cn": "这个花盆里能种点什么？",
        "question": [
          {
            "id": "gardening.dialogue.1.question",
            "text": "What could grow in this pot?",
            "audio": "gardening.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "gardening.dialogue.1.reply.1",
            "text": "A little flower.",
            "cn": "一朵小花。",
            "image": "gardening.flower.image",
            "audio": "gardening.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.1.reply.1.follow",
                "text": "Let us start with a seed.",
                "audio": "gardening.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "gardening.dialogue.1.reply.2",
            "text": "Can you show me?",
            "cn": "你能示范吗？",
            "image": "gardening.pot.image",
            "audio": "gardening.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.1.reply.2.follow",
                "text": "We will make room in the soil.",
                "audio": "gardening.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "gardening.dialogue.2",
        "cn": "种子放在哪里呢？",
        "question": [
          {
            "id": "gardening.dialogue.2.question",
            "text": "Where shall we put the seed?",
            "audio": "gardening.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "gardening.dialogue.2.reply.1",
            "text": "In the soil.",
            "cn": "放在土里。",
            "image": "gardening.seed.image",
            "audio": "gardening.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.2.reply.1.follow",
                "text": "Gently. Then cover it with a little soil.",
                "audio": "gardening.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "gardening.dialogue.2.reply.2",
            "text": "Please help me hold it.",
            "cn": "请帮我拿一下。",
            "image": "gardening.seed.image",
            "audio": "gardening.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.2.reply.2.follow",
                "text": "We can do this together.",
                "audio": "gardening.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "gardening.dialogue.3",
        "cn": "我们浇多少水呢？",
        "question": [
          {
            "id": "gardening.dialogue.3.question",
            "text": "How much water shall we pour?",
            "audio": "gardening.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "gardening.dialogue.3.reply.1",
            "text": "Just a little.",
            "cn": "一点点就好。",
            "image": "gardening.water.image",
            "audio": "gardening.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.3.reply.1.follow",
                "text": "Pour slowly. We can stop when ready.",
                "audio": "gardening.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "gardening.dialogue.3.reply.2",
            "text": "Show me, please.",
            "cn": "请示范一下。",
            "image": "gardening.water.image",
            "audio": "gardening.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.3.reply.2.follow",
                "text": "Watch me pour a little water.",
                "audio": "gardening.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "gardening.dialogue.4",
        "cn": "今天能看到花吗？",
        "question": [
          {
            "id": "gardening.dialogue.4.question",
            "text": "Can we see a flower today?",
            "audio": "gardening.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "gardening.dialogue.4.reply.1",
            "text": "Not yet. We can wait.",
            "cn": "还不能，我们可以等。",
            "image": "gardening.seed.image",
            "audio": "gardening.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.4.reply.1.follow",
                "text": "Growing takes more than one afternoon.",
                "audio": "gardening.dialogue.4.reply.1.follow.audio"
