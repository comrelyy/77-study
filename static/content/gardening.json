      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.1.reply.1.audio.wav",
      "text": "A little flower.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.1.reply.1.follow.audio.wav",
      "text": "Let us start with a seed.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.1.reply.2.audio.wav",
      "text": "Can you show me?",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.1.reply.2.follow.audio.wav",
      "text": "We will make room in the soil.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.2.question.audio.wav",
      "text": "Where shall we put the seed?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.2.reply.1.audio.wav",
      "text": "In the soil.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.2.reply.1.follow.audio.wav",
      "text": "Gently. Then cover it with a little soil.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.2.reply.2.audio.wav",
      "text": "Please help me hold it.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.2.reply.2.follow.audio.wav",
      "text": "We can do this together.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.3.question.audio.wav",
      "text": "How much water shall we pour?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.3.reply.1.audio.wav",
      "text": "Just a little.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.3.reply.1.follow.audio.wav",
      "text": "Pour slowly. We can stop when ready.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.3.reply.2.audio.wav",
      "text": "Show me, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.3.reply.2.follow.audio.wav",
      "text": "Watch me pour a little water.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.4.question.audio.wav",
      "text": "Can we see a flower today?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.4.reply.1.audio.wav",
      "text": "Not yet. We can wait.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.4.reply.1.follow.audio.wav",
      "text": "Growing takes more than one afternoon.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.4.reply.2.audio.wav",
      "text": "I want to see it now.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.4.reply.2.follow.audio.wav",
      "text": "Waiting can feel hard. I will wait with you.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.5.question.audio.wav",
      "text": "Many days have passed. What do you see?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.5.reply.1.audio.wav",
      "text": "Our flower is here!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.5.reply.1.follow.audio.wav",
      "text": "The little seed has grown.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.5.reply.2.audio.wav",
      "text": "Come and look with me.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.5.reply.2.follow.audio.wav",
      "text": "I am coming. Let us look closely.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.6.question.audio.wav",
      "text": "Who will check the pot tomorrow?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.6.reply.1.audio.wav",
      "text": "My turn tomorrow!",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.6.reply.1.follow.audio.wav",
      "text": "I checked today. We can take turns.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.6.reply.2.audio.wav",
      "text": "Let us make a plan.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "gardening.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/gardening/v0-1-0/gardening.dialogue.6.reply.2.follow.audio.wav",
      "text": "We can share the job.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
