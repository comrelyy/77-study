          },
          {
            "id": "gardening.dialogue.4.reply.2",
            "text": "I want to see it now.",
            "cn": "我现在就想看到。",
            "image": "gardening.seed.image",
            "audio": "gardening.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.4.reply.2.follow",
                "text": "Waiting can feel hard. I will wait with you.",
                "audio": "gardening.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "gardening.dialogue.5",
        "cn": "过了好多天，你看见了什么？",
        "question": [
          {
            "id": "gardening.dialogue.5.question",
            "text": "Many days have passed. What do you see?",
            "audio": "gardening.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "gardening.dialogue.5.reply.1",
            "text": "Our flower is here!",
            "cn": "我们的花开啦！",
            "image": "gardening.flower.image",
            "audio": "gardening.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "gardening.dialogue.5.reply.1.follow",
