    "dialogue": [
      {
        "id": "birthday.dialogue.1",
        "cn": "你想戴什么？",
        "question": [
          {
            "id": "birthday.dialogue.1.question",
            "text": "What do you want to wear?",
            "audio": "birthday.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.1.reply.1",
            "text": "I want to wear the hat.",
            "cn": "我想戴这顶帽子。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.1.reply.1.follow",
                "text": "The hat looks great on you!",
                "audio": "birthday.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.1.reply.2",
            "text": "The hat, please.",
            "cn": "请给我帽子。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.1.reply.2.follow",
                "text": "Yes, put it on your head.",
                "audio": "birthday.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.2",
        "cn": "杯子里有什么？",
        "question": [
          {
            "id": "birthday.dialogue.2.question",
            "text": "What is in the cup?",
            "audio": "birthday.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.2.reply.1",
            "text": "There is juice.",
            "cn": "有果汁。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.2.reply.1.follow",
                "text": "Yummy! Drink it slowly.",
                "audio": "birthday.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.2.reply.2",
            "text": "I see juice in the cup.",
            "cn": "我看见杯子里有果汁。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.2.reply.2.follow",
                "text": "Hold the cup with two hands.",
                "audio": "birthday.dialogue.2.reply.2.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.2.reply.3",
            "text": "There is milk.",
            "cn": "有牛奶。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.2.reply.3.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.2.reply.3.follow",
                "text": "Milk is good for you.",
                "audio": "birthday.dialogue.2.reply.3.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.3",
        "cn": "我们玩什么好呢？",
        "question": [
          {
            "id": "birthday.dialogue.3.question",
            "text": "What shall we play?",
            "audio": "birthday.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.3.reply.1",
            "text": "We can play with the ball.",
            "cn": "我们玩球吧。",
            "image": "birthday.ball.image",
            "audio": "birthday.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.3.reply.1.follow",
                "text": "Great! I will catch it.",
                "audio": "birthday.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.3.reply.2",
            "text": "We can roll the ball.",
            "cn": "我们可以滚球。",
            "image": "birthday.ball.image",
            "audio": "birthday.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.3.reply.2.follow",
                "text": "Here it comes. Roll, roll, roll!",
                "audio": "birthday.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.4",
        "cn": "你想抱谁？",
        "question": [
          {
            "id": "birthday.dialogue.4.question",
            "text": "Who do you want to hug?",
            "audio": "birthday.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.4.reply.1",
            "text": "I hug the teddy.",
            "cn": "我抱泰迪熊。",
            "image": "birthday.teddy.image",
            "audio": "birthday.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.4.reply.1.follow",
                "text": "The teddy likes a gentle hug.",
                "audio": "birthday.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.4.reply.2",
            "text": "I want the teddy.",
            "cn": "我想抱泰迪熊。",
            "image": "birthday.teddy.image",
            "audio": "birthday.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.4.reply.2.follow",
                "text": "Here you are. Hug it softly.",
                "audio": "birthday.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.5",
        "cn": "你的帽子是什么颜色？",
        "question": [
          {
            "id": "birthday.dialogue.5.question",
            "text": "What color is your hat?",
            "audio": "birthday.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.5.reply.1",
            "text": "My hat is red.",
            "cn": "我的帽子是红色的。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.5.reply.1.follow",
                "text": "Red is a lovely color.",
                "audio": "birthday.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.5.reply.2",
            "text": "It is blue.",
            "cn": "是蓝色的。",
            "image": "birthday.hat.image",
            "audio": "birthday.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.5.reply.2.follow",
                "text": "Blue is a nice color.",
                "audio": "birthday.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "birthday.dialogue.6",
        "cn": "今天你最喜欢什么？",
        "question": [
          {
            "id": "birthday.dialogue.6.question",
            "text": "What do you like best today?",
            "audio": "birthday.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "birthday.dialogue.6.reply.1",
            "text": "I like the ball.",
            "cn": "我最喜欢球。",
            "image": "birthday.ball.image",
            "audio": "birthday.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.6.reply.1.follow",
                "text": "Me too! It is round and fun.",
                "audio": "birthday.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.6.reply.2",
            "text": "I like the cup.",
            "cn": "我最喜欢杯子。",
            "image": "birthday.cup.image",
            "audio": "birthday.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.6.reply.2.follow",
                "text": "Nice cup! Drink your juice.",
                "audio": "birthday.dialogue.6.reply.2.follow.audio"
              }
            ]
          },
          {
            "id": "birthday.dialogue.6.reply.3",
            "text": "I like the teddy.",
            "cn": "我最喜欢泰迪熊。",
            "image": "birthday.teddy.image",
            "audio": "birthday.dialogue.6.reply.3.audio",
            "followUp": [
              {
                "id": "birthday.dialogue.6.reply.3.follow",
                "text": "The teddy is a good friend.",
                "audio": "birthday.dialogue.6.reply.3.follow.audio"
              }
            ]
          }
        ]
      }
