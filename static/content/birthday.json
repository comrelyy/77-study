        "mainWord": "en.hat.clothing",
        "hotspots": [
          {
            "word": "en.hat.clothing",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "到了生日会，Momo 戴上了一顶红色的帽子。",
        "segments": [
          {
            "id": "birthday.story.1.intro",
            "text": "Momo and Lulu come to the birthday party.",
            "speaker": "narrator",
            "audio": "birthday.story.1.intro.audio"
          },
          {
            "id": "birthday.story.1.item",
            "text": "Look at my new hat!",
            "speaker": "momo",
            "audio": "birthday.story.1.item.audio"
          },
          {
            "id": "birthday.story.1.reply",
            "text": "It is a red hat. I like it.",
            "speaker": "bunny",
            "audio": "birthday.story.1.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.2",
        "title": "2. 一杯果汁",
        "templateId": "daily-life",
        "illustration": "birthday.story.2.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.cup.container",
        "hotspots": [
          {
            "word": "en.cup.container",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "Lulu 给大家倒了一杯果汁。",
        "segments": [
          {
            "id": "birthday.story.2.intro",
            "text": "Lulu pours juice into a cup.",
            "speaker": "narrator",
            "audio": "birthday.story.2.intro.audio"
          },
          {
            "id": "birthday.story.2.item",
            "text": "Can I hold the cup?",
            "speaker": "momo",
            "audio": "birthday.story.2.item.audio"
          },
          {
            "id": "birthday.story.2.reply",
            "text": "Yes, please. Be gentle with it.",
            "speaker": "bunny",
            "audio": "birthday.story.2.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.3",
        "title": "3. 圆圆的球",
        "templateId": "daily-life",
        "illustration": "birthday.story.3.image",
        "characters": [
          "birthday.momo",
          "birthday.bunny"
        ],
        "mainWord": "en.ball.toy",
        "hotspots": [
          {
            "word": "en.ball.toy",
            "x": 0.26666666666666666,
            "y": 0.75
          }
        ],
        "translation": "他们在草地上玩球。",
        "segments": [
          {
            "id": "birthday.story.3.intro",
            "text": "The friends play on the grass.",
            "speaker": "narrator",
            "audio": "birthday.story.3.intro.audio"
          },
          {
            "id": "birthday.story.3.item",
            "text": "I kick the ball to you.",
            "speaker": "momo",
            "audio": "birthday.story.3.item.audio"
          },
          {
            "id": "birthday.story.3.reply",
            "text": "I catch the ball. Hooray!",
            "speaker": "bunny",
            "audio": "birthday.story.3.reply.audio"
          }
        ]
      },
      {
        "id": "birthday.story.4",
        "title": "4. 泰迪熊",
        "templateId": "daily-life",
        "illustration": "birthday.story.4.image",
        "characters": [
          "birthday.momo",
