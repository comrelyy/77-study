    {
      "id": "washing.dialogue.1.question.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.1.question.audio.wav",
      "text": "Shall we wash our muddy hands?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.1.reply.1.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.1.reply.1.audio.wav",
      "text": "Yes, some water, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.1.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.1.reply.1.follow.audio.wav",
      "text": "Let us ask our grown-up to check the water.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.1.reply.2.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.1.reply.2.audio.wav",
      "text": "Please help me reach.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.1.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.1.reply.2.follow.audio.wav",
      "text": "I will call our grown-up to help.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.2.question.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.2.question.audio.wav",
      "text": "What do we need for the bubbles?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.2.reply.1.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.2.reply.1.audio.wav",
      "text": "A little soap, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.2.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.2.reply.1.follow.audio.wav",
      "text": "Rub your hands together with the soap.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.2.reply.2.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.2.reply.2.audio.wav",
      "text": "Can you show me?",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.2.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.2.reply.2.follow.audio.wav",
      "text": "Watch my hands. We can rub them together.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.3.question.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.3.question.audio.wav",
      "text": "How does the water feel?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.3.reply.1.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.3.reply.1.audio.wav",
      "text": "It feels comfortable.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.3.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.3.reply.1.follow.audio.wav",
      "text": "Good. We can rinse the bubbles away.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.3.reply.2.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.3.reply.2.audio.wav",
      "text": "It feels too hot.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.3.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.3.reply.2.follow.audio.wav",
      "text": "Stop and ask our grown-up for help.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.4.question.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.4.question.audio.wav",
      "text": "Where can we dry our hands?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.4.reply.1.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.4.reply.1.audio.wav",
      "text": "With the towel.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.4.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.4.reply.1.follow.audio.wav",
      "text": "Here it is. Pat your hands dry.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.4.reply.2.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.4.reply.2.audio.wav",
      "text": "My hands are still wet.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.4.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.4.reply.2.follow.audio.wav",
      "text": "We can use the towel again.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.5.question.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.5.question.audio.wav",
      "text": "Where does the towel go now?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.5.reply.1.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.5.reply.1.audio.wav",
      "text": "Back on the hook.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.5.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.5.reply.1.follow.audio.wav",
      "text": "Yes. We leave it hanging to dry.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.5.reply.2.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.5.reply.2.audio.wav",
      "text": "Help me hang it, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.5.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.5.reply.2.follow.audio.wav",
      "text": "I can help you reach the hook.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.6.question.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.6.question.audio.wav",
      "text": "Is your toothbrush ready?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.6.reply.1.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.6.reply.1.audio.wav",
      "text": "Yes! Help me brush, please.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.6.reply.1.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.6.reply.1.follow.audio.wav",
      "text": "Let us ask our grown-up to help.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.6.reply.2.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.6.reply.2.audio.wav",
      "text": "Please wait a moment.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.dialogue.6.reply.2.follow.audio",
      "kind": "audio",
      "path": "audio/washing/v0-1-0/washing.dialogue.6.reply.2.follow.audio.wav",
      "text": "We can take a moment before brushing.",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
