  "modules": {
    "story": [
      {
        "id": "washing.story.1",
        "title": "1. 带着泥点回来了",
        "templateId": "daily-life",
        "illustration": "washing.story.1.image",
        "characters": [
          "washing.momo",
          "washing.bunny"
        ],
        "mainWord": "en.water.drink",
        "hotspots": [
          {
            "word": "en.water.drink",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "玩过以后，两人的手都沾了泥。他们决定一起洗手。",
        "segments": [
          {
            "id": "washing.story.1.intro",
            "text": "The friends come home with muddy hands.",
            "cn": "朋友们带着一手泥回到家。",
            "speaker": "narrator",
            "audio": "washing.story.1.intro.audio"
          },
          {
            "id": "washing.story.1.item",
            "text": "Look at my hands!",
            "cn": "看我的手！",
            "speaker": "momo",
            "audio": "washing.story.1.item.audio"
          },
          {
            "id": "washing.story.1.reply",
            "text": "Mine too. Let us wash them.",
            "cn": "我的也是。我们去洗手吧。",
            "speaker": "bunny",
            "audio": "washing.story.1.reply.audio"
          },
          {
            "id": "washing.story.1.more1",
            "text": "Where is the soap?",
            "cn": "肥皂在哪儿？",
            "speaker": "momo",
            "audio": "washing.story.1.more1.audio"
          },
          {
            "id": "washing.story.1.more2",
            "text": "It is by the sink.",
            "cn": "在水池旁边。",
            "speaker": "bunny",
            "audio": "washing.story.1.more2.audio"
          }
        ]
      },
      {
        "id": "washing.story.2",
        "title": "2. 泡泡太少啦",
        "templateId": "daily-life",
        "illustration": "washing.story.2.image",
        "characters": [
          "washing.momo",
          "washing.bunny"
        ],
        "mainWord": "en.soap.wash",
        "hotspots": [
          {
            "word": "en.soap.wash",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "Momo 拿起肥皂，却搓不出泡泡。Lulu 示范双手一起搓。",
        "segments": [
          {
            "id": "washing.story.2.intro",
            "text": "Momo picks up the soap.",
            "cn": "Momo 拿起了肥皂。",
            "speaker": "narrator",
            "audio": "washing.story.2.intro.audio"
          },
          {
            "id": "washing.story.2.item",
            "text": "I cannot make bubbles.",
            "cn": "我搓不出泡泡。",
            "speaker": "momo",
            "audio": "washing.story.2.item.audio"
          },
          {
            "id": "washing.story.2.reply",
            "text": "Rub both hands together. Like this.",
            "cn": "两只手一起搓，像这样。",
            "speaker": "bunny",
            "audio": "washing.story.2.reply.audio"
          },
          {
            "id": "washing.story.2.more1",
            "text": "Look! Lots of bubbles now.",
            "cn": "看！现在有好多泡泡。",
            "speaker": "momo",
            "audio": "washing.story.2.more1.audio"
          }
        ]
      },
      {
        "id": "washing.story.3",
        "title": "3. 泡泡冲走了",
        "templateId": "daily-life",
        "illustration": "washing.story.3.image",
        "characters": [
          "washing.momo",
          "washing.bunny"
        ],
        "mainWord": "en.water.drink",
        "hotspots": [
          {
            "word": "en.water.drink",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "清水冲走泡泡。Lulu 提醒洗好了就关水，Momo 伸手关上水龙头。",
        "segments": [
          {
            "id": "washing.story.3.intro",
            "text": "Little bubbles slide towards the sink.",
            "cn": "小泡泡滑向水池。",
            "speaker": "narrator",
            "audio": "washing.story.3.intro.audio"
          },
          {
            "id": "washing.story.3.item",
            "text": "The bubbles are going away!",
            "cn": "泡泡不见啦！",
            "speaker": "momo",
            "audio": "washing.story.3.item.audio"
          },
          {
            "id": "washing.story.3.reply",
            "text": "Yes. Now turn off the water.",
            "cn": "对。现在把水关上吧。",
            "speaker": "bunny",
            "audio": "washing.story.3.reply.audio"
          },
          {
            "id": "washing.story.3.more1",
            "text": "I turned it off. Is that right?",
            "cn": "我关上了。这样对吗？",
            "speaker": "momo",
            "audio": "washing.story.3.more1.audio"
          },
          {
            "id": "washing.story.3.more2",
            "text": "Yes. We save water that way.",
            "cn": "对。这样可以节约用水。",
            "speaker": "bunny",
            "audio": "washing.story.3.more2.audio"
          }
        ]
      },
      {
        "id": "washing.story.4",
        "title": "4. 轮到谁擦手",
        "templateId": "daily-life",
        "illustration": "washing.story.4.image",
        "characters": [
          "washing.bunny",
          "washing.momo"
        ],
        "mainWord": "en.towel.wash",
        "hotspots": [
          {
            "word": "en.towel.wash",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "洗手台边有一条毛巾。Lulu 让 Momo 先擦，Momo 擦好后交给朋友。",
        "segments": [
          {
            "id": "washing.story.4.intro",
            "text": "There is one towel beside the sink.",
            "cn": "水池边有一条毛巾。",
            "speaker": "narrator",
            "audio": "washing.story.4.intro.audio"
          },
          {
            "id": "washing.story.4.item",
            "text": "Your turn first. I can wait.",
            "cn": "你先用，我可以等。",
            "speaker": "bunny",
            "audio": "washing.story.4.item.audio"
          },
          {
            "id": "washing.story.4.reply",
            "text": "Thank you. Now it is your turn.",
            "cn": "谢谢你。现在轮到你了。",
            "speaker": "momo",
            "audio": "washing.story.4.reply.audio"
          },
          {
            "id": "washing.story.4.more1",
            "text": "My hands are dry too.",
            "cn": "我的手也擦干了。",
            "speaker": "bunny",
            "audio": "washing.story.4.more1.audio"
          }
        ]
      },
      {
        "id": "washing.story.5",
        "title": "5. 找到各自的牙刷",
        "templateId": "daily-life",
        "illustration": "washing.story.5.image",
        "characters": [
          "washing.momo",
          "washing.bunny"
        ],
        "mainWord": "en.toothbrush.wash",
        "hotspots": [
          {
            "word": "en.toothbrush.wash",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "杯子里有两把牙刷。两人分清各自的牙刷，不拿错朋友的。",
        "segments": [
          {
            "id": "washing.story.5.intro",
            "text": "Two toothbrushes wait in a cup.",
            "cn": "杯子里放着两把牙刷。",
            "speaker": "narrator",
            "audio": "washing.story.5.intro.audio"
          },
          {
            "id": "washing.story.5.item",
            "text": "Is this your toothbrush?",
            "cn": "这是你的牙刷吗？",
            "speaker": "momo",
            "audio": "washing.story.5.item.audio"
          },
          {
            "id": "washing.story.5.reply",
            "text": "Yes. That one is yours.",
            "cn": "是的。那把是你的。",
            "speaker": "bunny",
            "audio": "washing.story.5.reply.audio"
          },
          {
            "id": "washing.story.5.more1",
            "text": "Mine is the blue one.",
            "cn": "我的是蓝色那把。",
            "speaker": "momo",
            "audio": "washing.story.5.more1.audio"
          },
          {
            "id": "washing.story.5.more2",
            "text": "And mine is the pink one.",
            "cn": "我的是粉色那把。",
            "speaker": "bunny",
            "audio": "washing.story.5.more2.audio"
          }
        ]
      },
      {
        "id": "washing.story.6",
        "title": "6. 用品回到原处",
        "templateId": "daily-life",
        "illustration": "washing.story.6.image",
        "characters": [
          "washing.momo",
          "washing.bunny"
        ],
        "mainWord": "en.towel.wash",
        "hotspots": [
          {
            "word": "en.towel.wash",
            "x": 0.5,
            "y": 0.6
          }
        ],
        "translation": "他们把肥皂、牙刷放好。Lulu 发现毛巾还没挂，两人一起完成最后一步。",
        "segments": [
          {
            "id": "washing.story.6.intro",
            "text": "The sink is clean again.",
            "cn": "水池又干干净净了。",
            "speaker": "narrator",
            "audio": "washing.story.6.intro.audio"
          },
          {
            "id": "washing.story.6.item",
            "text": "Soap here, toothbrush there. All done?",
            "cn": "肥皂放这儿，牙刷放那儿。都弄好了吗？",
            "speaker": "momo",
            "audio": "washing.story.6.item.audio"
          },
          {
            "id": "washing.story.6.reply",
            "text": "The towel needs its hook. Now we are done!",
            "cn": "毛巾还要挂到钩子上。现在弄好啦！",
            "speaker": "bunny",
            "audio": "washing.story.6.reply.audio"
          },
          {
            "id": "washing.story.6.more1",
            "text": "Our hands are clean. Shall we go and play?",
            "cn": "我们的手干净了。去玩好吗？",
            "speaker": "momo",
            "audio": "washing.story.6.more1.audio"
          }
        ]
      }
    ],
    "dialogue": [
      {
        "id": "washing.dialogue.1",
        "cn": "我们洗洗沾了泥的手好吗？",
        "question": [
          {
            "id": "washing.dialogue.1.question",
            "text": "Shall we wash our muddy hands?",
            "audio": "washing.dialogue.1.question.audio"
          }
        ],
        "options": [
          {
            "id": "washing.dialogue.1.reply.1",
            "text": "Yes, some water, please.",
            "cn": "好，请放一点水。",
            "image": "washing.water.image",
            "audio": "washing.dialogue.1.reply.1.audio",
            "followUp": [
              {
                "id": "washing.dialogue.1.reply.1.follow",
                "text": "Let us ask our grown-up to check the water.",
                "audio": "washing.dialogue.1.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "washing.dialogue.1.reply.2",
            "text": "Please help me reach.",
            "cn": "请帮我够到洗手台。",
            "image": "washing.water.image",
            "audio": "washing.dialogue.1.reply.2.audio",
            "followUp": [
              {
                "id": "washing.dialogue.1.reply.2.follow",
                "text": "I will call our grown-up to help.",
                "audio": "washing.dialogue.1.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "washing.dialogue.2",
        "cn": "我们用什么搓泡泡呢？",
        "question": [
          {
            "id": "washing.dialogue.2.question",
            "text": "What do we need for the bubbles?",
            "audio": "washing.dialogue.2.question.audio"
          }
        ],
        "options": [
          {
            "id": "washing.dialogue.2.reply.1",
            "text": "A little soap, please.",
            "cn": "请给我一点肥皂。",
            "image": "washing.soap.image",
            "audio": "washing.dialogue.2.reply.1.audio",
            "followUp": [
              {
                "id": "washing.dialogue.2.reply.1.follow",
                "text": "Rub your hands together with the soap.",
                "audio": "washing.dialogue.2.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "washing.dialogue.2.reply.2",
            "text": "Can you show me?",
            "cn": "你能示范一下吗？",
            "image": "washing.soap.image",
            "audio": "washing.dialogue.2.reply.2.audio",
            "followUp": [
              {
                "id": "washing.dialogue.2.reply.2.follow",
                "text": "Watch my hands. We can rub them together.",
                "audio": "washing.dialogue.2.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "washing.dialogue.3",
        "cn": "水感觉怎么样？",
        "question": [
          {
            "id": "washing.dialogue.3.question",
            "text": "How does the water feel?",
            "audio": "washing.dialogue.3.question.audio"
          }
        ],
        "options": [
          {
            "id": "washing.dialogue.3.reply.1",
            "text": "It feels comfortable.",
            "cn": "感觉很舒服。",
            "image": "washing.water.image",
            "audio": "washing.dialogue.3.reply.1.audio",
            "followUp": [
              {
                "id": "washing.dialogue.3.reply.1.follow",
                "text": "Good. We can rinse the bubbles away.",
                "audio": "washing.dialogue.3.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "washing.dialogue.3.reply.2",
            "text": "It feels too hot.",
            "cn": "感觉太烫了。",
            "image": "washing.water.image",
            "audio": "washing.dialogue.3.reply.2.audio",
            "followUp": [
              {
                "id": "washing.dialogue.3.reply.2.follow",
                "text": "Stop and ask our grown-up for help.",
                "audio": "washing.dialogue.3.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "washing.dialogue.4",
        "cn": "我们在哪里擦干手呢？",
        "question": [
          {
            "id": "washing.dialogue.4.question",
            "text": "Where can we dry our hands?",
            "audio": "washing.dialogue.4.question.audio"
          }
        ],
        "options": [
          {
            "id": "washing.dialogue.4.reply.1",
            "text": "With the towel.",
            "cn": "用毛巾擦。",
            "image": "washing.towel.image",
            "audio": "washing.dialogue.4.reply.1.audio",
            "followUp": [
              {
                "id": "washing.dialogue.4.reply.1.follow",
                "text": "Here it is. Pat your hands dry.",
                "audio": "washing.dialogue.4.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "washing.dialogue.4.reply.2",
            "text": "My hands are still wet.",
            "cn": "我的手还湿着。",
            "image": "washing.towel.image",
            "audio": "washing.dialogue.4.reply.2.audio",
            "followUp": [
              {
                "id": "washing.dialogue.4.reply.2.follow",
                "text": "We can use the towel again.",
                "audio": "washing.dialogue.4.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "washing.dialogue.5",
        "cn": "毛巾用完放在哪里？",
        "question": [
          {
            "id": "washing.dialogue.5.question",
            "text": "Where does the towel go now?",
            "audio": "washing.dialogue.5.question.audio"
          }
        ],
        "options": [
          {
            "id": "washing.dialogue.5.reply.1",
            "text": "Back on the hook.",
            "cn": "挂回挂钩上。",
            "image": "washing.towel.image",
            "audio": "washing.dialogue.5.reply.1.audio",
            "followUp": [
              {
                "id": "washing.dialogue.5.reply.1.follow",
                "text": "Yes. We leave it hanging to dry.",
                "audio": "washing.dialogue.5.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "washing.dialogue.5.reply.2",
            "text": "Help me hang it, please.",
            "cn": "请帮我挂好。",
            "image": "washing.towel.image",
            "audio": "washing.dialogue.5.reply.2.audio",
            "followUp": [
              {
                "id": "washing.dialogue.5.reply.2.follow",
                "text": "I can help you reach the hook.",
                "audio": "washing.dialogue.5.reply.2.follow.audio"
              }
            ]
          }
        ]
      },
      {
        "id": "washing.dialogue.6",
        "cn": "你的牙刷准备好了吗？",
        "question": [
          {
            "id": "washing.dialogue.6.question",
            "text": "Is your toothbrush ready?",
            "audio": "washing.dialogue.6.question.audio"
          }
        ],
        "options": [
          {
            "id": "washing.dialogue.6.reply.1",
            "text": "Yes! Help me brush, please.",
            "cn": "好啦，请帮我刷牙。",
            "image": "washing.toothbrush.image",
            "audio": "washing.dialogue.6.reply.1.audio",
            "followUp": [
              {
                "id": "washing.dialogue.6.reply.1.follow",
                "text": "Let us ask our grown-up to help.",
                "audio": "washing.dialogue.6.reply.1.follow.audio"
              }
            ]
          },
          {
            "id": "washing.dialogue.6.reply.2",
            "text": "Please wait a moment.",
            "cn": "请等一下。",
            "image": "washing.toothbrush.image",
            "audio": "washing.dialogue.6.reply.2.audio",
            "followUp": [
              {
                "id": "washing.dialogue.6.reply.2.follow",
                "text": "We can take a moment before brushing.",
                "audio": "washing.dialogue.6.reply.2.follow.audio"
              }
            ]
          }
        ]
      }
    ],
    "game": {
