    },
    {
      "id": "washing.story.3.more1.audio",
      "kind": "audio",
      "path": "audio/washing/v0-2-0/washing.story.3.more1.audio.wav",
      "text": "I turned it off. Is that right?",
      "language": "en-US",
      "role": "momo",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
      "id": "washing.story.3.more2.audio",
      "kind": "audio",
      "path": "audio/washing/v0-2-0/washing.story.3.more2.audio.wav",
      "text": "Yes. We save water that way.",
      "language": "en-US",
      "role": "bunny",
      "source": null,
      "rights": null,
      "reviewed": false
    },
    {
